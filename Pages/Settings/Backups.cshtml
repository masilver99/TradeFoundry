@page "/journal/{journalId:guid}/settings/backups"
@model TradeFoundry.Pages.Settings.BackupsModel
@using System.Globalization
@using TradeFoundry.Core
@using TradeFoundry.Services.Backup
@inject HostInstance Instance
@{
    ViewData["Title"] = "Backups";
    ViewData["PageKicker"] = "TRADEFOUNDRY / DATA / SETTINGS / BACKUPS";
    ViewData["ActiveNav"] = "settings";
    ViewData["SettingsSection"] = "backups";
    var lastGood = Model.Runs.FirstOrDefault(run => run.Status is BackupRunStatus.Completed or BackupRunStatus.CompletedWithWarnings);
    string Local(DateTimeOffset value) => value.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    var journalPath = $"/journal/{Model.JournalId:D}/settings/backups";
}

@await Html.PartialAsync("_SettingsNav", Model.JournalId)

@if (!string.IsNullOrWhiteSpace(Model.FlashMessage))
{
    <div class="alert tf-alert @(Model.FlashKind == "error" ? "error" : string.Empty)" role="status">@Model.FlashMessage</div>
}

<div class="tf-settings-intro">
    <div>
        <div class="tf-kicker">INSTANCE-WIDE</div>
        <h3 class="tf-settings-heading">Backups</h3>
        <p class="text-secondary mb-0">A backup holds every journal in this instance: the database, images, receipts and image settings. The site pauses for a few seconds while the journal is copied; edits made meanwhile are saved when it resumes.</p>
    </div>
</div>

@if (Model.Restarting)
{
    <div class="alert tf-alert" role="status" data-restart-wait data-instance="@Instance.Id">The current data is being moved aside. TradeFoundry restarts with an empty journal and continues to sign-in when it is ready.</div>
    return;
}

@if (Model.Warning is { } backupWarning)
{
    <div class="alert alert-warning" role="status">@backupWarning.Message</div>
}

@if (Model.RestoredFrom is { } restored)
{
    <div class="card tf-card border-warning mb-3">
        <div class="card-header"><div><div class="tf-kicker text-warning">AFTER RESTORE</div><h3 class="tf-card-title">Restored from the backup of @Local(restored.BackupCreatedUtc)</h3></div></div>
        <div class="card-body">
            <ul class="mb-3">
                @if (Model.IntegrationsPaused)
                {
                    <li>
                        Watched imports are paused. Check that these paths are right on this machine, then resume:
                        @if (Model.WatchedJournals.Count == 0)
                        {
                            <span class="text-secondary">no journal watches a folder or file.</span>
                        }
                        else
                        {
                            <ul>
                                @foreach (var journal in Model.WatchedJournals)
                                {
                                    <li><strong>@journal.Name</strong>: <span class="text-break">@(string.IsNullOrWhiteSpace(journal.ImportWatchDirectory) ? journal.ImportWatchFile : journal.ImportWatchDirectory)</span></li>
                                }
                            </ul>
                        }
                    </li>
                }
                <li>MCP access tokens were revoked. Create new ones in Settings &gt; Access.</li>
                <li>ChatGPT was not restored; sign in again where you use it. Publishing tokens come back only from encrypted backups, so enter them again if publishing asks for one.</li>
                <li>Backups go to the default folder until you choose another below. Encryption and Backblaze B2 are off until you set them up again on this machine.</li>
            </ul>
            <div class="d-flex flex-wrap gap-2">
                @if (Model.IntegrationsPaused)
                {
                    <form method="post" action="@($"{journalPath}?handler=ResumeIntegrations")">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-primary" type="submit">Resume watched imports</button>
                    </form>
                }
                <form method="post" action="@($"{journalPath}?handler=DismissRestore")">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-secondary" type="submit">Done</button>
                </form>
            </div>
        </div>
    </div>
}

<section class="row row-cards">
    <div class="col-xl-6">
        <div class="card tf-card" data-backup-status data-status-url="/backup-status" data-running="@(Model.Progress.Running ? "true" : "false")">
            <div class="card-header"><div><div class="tf-kicker">BACK UP</div><h3 class="tf-card-title">Back up now</h3></div></div>
            <div class="card-body">
                <dl class="tf-definition-list">
                    <dt>Last backup</dt>
                    <dd>@(lastGood is null ? "Never" : $"{Local(lastGood.StartedUtc)} · {(lastGood.ArchiveSize is { } size ? BackupsModel.FormatBytes(size) : "")}")</dd>
                    <dt>Folder</dt>
                    <dd class="text-break">@Model.Folder</dd>
                </dl>
                <div class="tf-backup-progress" data-backup-progress hidden="@(Model.Progress.Running ? null : "hidden")">
                    <div class="d-flex justify-content-between small"><span data-backup-stage>@Model.Progress.Stage</span><span data-backup-percent></span></div>
                    <div class="progress progress-sm mt-1"><div class="progress-bar" data-backup-bar style="width: @((int)Math.Round((Model.Progress.Fraction ?? 0) * 100))%"></div></div>
                </div>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <form method="post" action="@($"{journalPath}?handler=BackUpNow")" data-backup-start-form hidden="@(Model.Progress.Running ? "hidden" : null)">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-primary" type="submit">Back up now</button>
                    </form>
                    <form method="post" action="@($"{journalPath}?handler=Cancel")" data-backup-cancel-form hidden="@(Model.Progress.Running ? null : "hidden")">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-outline-secondary" type="submit">Cancel backup</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-6">
        <div class="card tf-card">
            <div class="card-header"><div><div class="tf-kicker">DESTINATION</div><h3 class="tf-card-title">Backup folder</h3></div></div>
            <div class="card-body">
                @if (Model.FolderSharesDrive)
                {
                    <div class="alert alert-warning small" role="note">This folder is on the same drive as the journal. A drive failure would lose both. Choose a folder on another drive or a synced folder.</div>
                }
                <form method="post" action="@($"{journalPath}?handler=Folder")" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <label class="form-label" for="backup-folder">Folder</label>
                    <input class="form-control" id="backup-folder" name="NewFolder" value="@(Model.UsesDefaultFolder ? string.Empty : Model.Folder)" placeholder="@Model.DefaultFolder" />
                    <div class="form-hint">Leave empty to use the default folder. It must be outside the data directory.</div>
                    <label class="form-label mt-3" for="backup-folder-password">Owner password</label>
                    <input class="form-control" id="backup-folder-password" name="CurrentPassword" type="password" autocomplete="current-password" />
                    <div class="form-hint">Required, because backups contain every journal.</div>
                    <button class="btn btn-outline-primary mt-3" type="submit">Save folder</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-xl-6">
        <div class="card tf-card h-100" id="encryption">
            <div class="card-header"><div><div class="tf-kicker">ENCRYPTION</div><h3 class="tf-card-title">Encrypt backups</h3></div><span class="badge @(Model.EncryptionEnabled ? "bg-success-lt" : "bg-secondary-lt") ms-auto">@(Model.EncryptionEnabled ? "On" : "Off")</span></div>
            <div class="card-body">
                <p class="text-secondary small">Encrypted backups use the open <a href="https://age-encryption.org" target="_blank" rel="noopener">age</a> format with a passphrase, so they can also be opened without TradeFoundry (<code>age -d backup.tfbackup &gt; backup.zip</code>). Only encrypted backups include publishing tokens. The passphrase is stored on this machine for scheduled backups, but <strong>a lost or broken computer takes it with it</strong>: keep a copy in a password manager or on paper.</p>
                <form method="post" action="@($"{journalPath}?handler=Encryption")" autocomplete="off" class="row g-2">
                    @Html.AntiForgeryToken()
                    <div class="col-md-6"><label class="form-label" for="backup-passphrase">@(Model.EncryptionEnabled ? "New passphrase" : "Passphrase")</label><input class="form-control" id="backup-passphrase" name="passphrase" type="password" autocomplete="new-password" minlength="@BackupEncryption.MinimumPassphraseLength" /></div>
                    <div class="col-md-6"><label class="form-label" for="backup-passphrase-confirm">Type it again</label><input class="form-control" id="backup-passphrase-confirm" name="confirmPassphrase" type="password" autocomplete="new-password" /></div>
                    <div class="col-12"><label class="form-check"><input class="form-check-input" type="checkbox" name="savedElsewhere" value="true" /> <span class="form-check-label">I have saved this passphrase somewhere other than this computer</span></label></div>
                    <div class="col-md-6"><label class="form-label" for="encryption-password">Owner password</label><input class="form-control" id="encryption-password" name="CurrentPassword" type="password" autocomplete="current-password" /></div>
                    <div class="col-12"><button class="btn btn-outline-primary" type="submit">@(Model.EncryptionEnabled ? "Change passphrase" : "Turn on encryption")</button></div>
                </form>
                @if (Model.EncryptionEnabled)
                {
                    <form method="post" action="@($"{journalPath}?handler=DisableEncryption")" autocomplete="off" class="row g-2 mt-3 pt-3 border-top">
                        @Html.AntiForgeryToken()
                        <div class="col-md-6"><label class="form-label" for="disable-encryption-password">Owner password</label><input class="form-control" id="disable-encryption-password" name="CurrentPassword" type="password" autocomplete="current-password" /></div>
                        <div class="col-md-6 d-flex align-items-end"><button class="btn btn-outline-danger" type="submit" disabled="@(Model.Cloud is not null)">Turn off encryption</button></div>
                        @if (Model.Cloud is not null)
                        {
                            <div class="col-12 form-hint">Turn off Backblaze B2 first: cloud backups are always encrypted.</div>
                        }
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="col-xl-6">
        <div class="card tf-card h-100" id="cloud">
            <div class="card-header"><div><div class="tf-kicker">OFFSITE</div><h3 class="tf-card-title">Backblaze B2</h3></div><span class="badge @(Model.Cloud is not null ? "bg-success-lt" : "bg-secondary-lt") ms-auto">@(Model.Cloud is not null ? "On" : "Off")</span></div>
            <div class="card-body">
                @if (Model.Cloud is { } cloud)
                {
                    <dl class="tf-definition-list">
                        <dt>Bucket</dt><dd>@cloud.Bucket</dd>
                        <dt>Endpoint</dt><dd class="text-break">@cloud.Endpoint</dd>
                        <dt>Key ID</dt><dd>@cloud.KeyId</dd>
                    </dl>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <form method="post" action="@($"{journalPath}?handler=TestCloud")">@Html.AntiForgeryToken()<button class="btn btn-outline-primary" type="submit">Test connection</button></form>
                        <form method="post" action="@($"{journalPath}?handler=RefreshCloud")">@Html.AntiForgeryToken()<button class="btn btn-outline-secondary" type="submit">List cloud backups</button></form>
                    </div>
                    @if (Model.CloudListing is { } listing)
                    {
                        @if (listing.Error is not null)
                        {
                            <div class="alert alert-danger small">@listing.Error</div>
                        }
                        else if (listing.Backups.Count == 0)
                        {
                            <p class="text-secondary small">No backups from this installation in the bucket (listed @Local(listing.ListedUtc)).</p>
                        }
                        else
                        {
                            <div class="small text-secondary mb-1">In the bucket, listed @Local(listing.ListedUtc):</div>
                            <ul class="small mb-3">
                                @foreach (var item in listing.Backups)
                                {
                                    <li>@Local(item.Sidecar.CreatedUtc) · @BackupsModel.FormatBytes(item.Sidecar.Size)@(item.Sidecar.Trigger == BackupTrigger.Manual ? " · manual" : string.Empty)</li>
                                }
                            </ul>
                        }
                    }
                }
                else
                {
                    <p class="text-secondary small">Uploads each backup, encrypted, to a private Backblaze B2 bucket after it is saved to the folder. Use a key that can read, write and list but <strong>not delete</strong>, limited to one bucket and the <code>tradefoundry/</code> prefix, and give the bucket a lifecycle rule that erases hidden files after 30 days. Pruned backups can then be recovered for 30 days, and a stolen key cannot erase them. The Backblaze website cannot create such a key; use the B2 command line:</p>
                    <pre class="small bg-body-tertiary p-2 rounded text-wrap"><code>b2 key create --bucket YOUR-BUCKET --name-prefix tradefoundry/ tradefoundry-backups listFiles,readFiles,writeFiles,listAllBucketNames</code></pre>
                }
                <form method="post" action="@($"{journalPath}?handler=Cloud")" autocomplete="off" class="row g-2 @(Model.Cloud is null ? string.Empty : "mt-2 pt-3 border-top")">
                    @Html.AntiForgeryToken()
                    <div class="col-md-6"><label class="form-label" for="b2-endpoint">S3 endpoint</label><input class="form-control" id="b2-endpoint" name="endpoint" value="@Model.Cloud?.Endpoint" placeholder="https://s3.us-west-002.backblazeb2.com" /></div>
                    <div class="col-md-6"><label class="form-label" for="b2-bucket">Bucket</label><input class="form-control" id="b2-bucket" name="bucket" value="@Model.Cloud?.Bucket" /></div>
                    <div class="col-md-6"><label class="form-label" for="b2-key-id">Application key ID</label><input class="form-control" id="b2-key-id" name="keyId" value="@Model.Cloud?.KeyId" /></div>
                    <div class="col-md-6"><label class="form-label" for="b2-key">Application key</label><input class="form-control" id="b2-key" name="applicationKey" type="password" autocomplete="off" placeholder="@(Model.Cloud is null ? string.Empty : "Saved; leave empty to keep it")" /></div>
                    <div class="col-md-6"><label class="form-label" for="b2-password">Owner password</label><input class="form-control" id="b2-password" name="CurrentPassword" type="password" autocomplete="current-password" /></div>
                    <div class="col-12 form-hint">
                        @if (!Model.EncryptionEnabled) { <span class="text-warning">Turn on encryption first. </span> }
                        @if (!Model.OwnerHasPassword) { <span class="text-warning">Set an owner password first. </span> }
                        Saving tests the connection. The key is stored on this machine with its data protection keys and never included in a backup.
                    </div>
                    <div class="col-12"><button class="btn btn-outline-primary" type="submit" disabled="@(!Model.EncryptionEnabled || !Model.OwnerHasPassword)">@(Model.Cloud is null ? "Test and turn on" : "Test and save")</button></div>
                </form>
                @if (Model.Cloud is not null)
                {
                    <form method="post" action="@($"{journalPath}?handler=DisableCloud")" autocomplete="off" class="row g-2 mt-3 pt-3 border-top">
                        @Html.AntiForgeryToken()
                        <div class="col-md-6"><label class="form-label" for="disable-cloud-password">Owner password</label><input class="form-control" id="disable-cloud-password" name="CurrentPassword" type="password" autocomplete="current-password" /></div>
                        <div class="col-md-6 d-flex align-items-end"><button class="btn btn-outline-danger" type="submit">Stop uploading</button></div>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card tf-card">
            <div class="card-header"><div><div class="tf-kicker">SCHEDULE</div><h3 class="tf-card-title">Scheduled backups</h3></div></div>
            <div class="card-body">
                <p class="text-secondary small">@(Model.Schedule.Enabled && Model.NextRun is { } next ? $"Next backup: {Local(next)}." : Model.Schedule.Enabled ? "The next backup time is being worked out." : "Scheduled backups are off.") A backup missed while the computer was off or asleep runs once, five minutes after TradeFoundry starts or wakes. Failed backups are retried after 5, 30 and 120 minutes.</p>
                <form method="post" action="@($"{journalPath}?handler=Schedule")" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-12"><label class="form-check form-switch"><input class="form-check-input" type="checkbox" name="enabled" value="true" checked="@Model.Schedule.Enabled" /><span class="form-check-label">Back up on a schedule</span></label></div>
                    <div class="col-sm-6 col-lg-3">
                        <label class="form-label" for="schedule-frequency">How often</label>
                        <select class="form-select" id="schedule-frequency" name="frequency">
                            <option value="daily" selected="@(Model.Schedule.Frequency == BackupFrequency.Daily)">Every day</option>
                            <option value="weekly" selected="@(Model.Schedule.Frequency == BackupFrequency.Weekly)">Every week</option>
                        </select>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label class="form-label" for="schedule-day">Day (weekly)</label>
                        <select class="form-select" id="schedule-day" name="day">
                            @foreach (var day in Enum.GetValues<DayOfWeek>())
                            {
                                <option value="@day" selected="@(Model.Schedule.Day == day)">@day</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-6 col-lg-2"><label class="form-label" for="schedule-time">Time</label><input class="form-control" id="schedule-time" name="time" type="time" value="@Model.Schedule.Time.ToString("HH:mm", CultureInfo.InvariantCulture)" required /></div>
                    <div class="col-sm-6 col-lg-4"><label class="form-label" for="schedule-zone">Time zone</label><input class="form-control" id="schedule-zone" name="timeZone" list="schedule-zones" value="@Model.Schedule.TimeZoneId" /><datalist id="schedule-zones">@foreach (var zone in BackupsModel.TimeZoneIds){<option value="@zone"></option>}</datalist></div>
                    <div class="col-12"><div class="form-label mb-1">Keep the newest backup of each of the last</div></div>
                    <div class="col-4 col-lg-2"><label class="form-label small" for="keep-daily">Days</label><input class="form-control" id="keep-daily" name="keepDaily" type="number" min="1" max="90" value="@Model.Schedule.KeepDaily" /></div>
                    <div class="col-4 col-lg-2"><label class="form-label small" for="keep-weekly">Weeks</label><input class="form-control" id="keep-weekly" name="keepWeekly" type="number" min="0" max="52" value="@Model.Schedule.KeepWeekly" /></div>
                    <div class="col-4 col-lg-2"><label class="form-label small" for="keep-monthly">Months</label><input class="form-control" id="keep-monthly" name="keepMonthly" type="number" min="0" max="60" value="@Model.Schedule.KeepMonthly" /></div>
                    <div class="col-12 form-hint">Only this installation's scheduled backups are deleted. Manual backups, backups from other installations and the newest backup are always kept.</div>
                    <div class="col-12"><button class="btn btn-outline-primary" type="submit">Save schedule</button></div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="card tf-card">
            <div class="card-header"><div><div class="tf-kicker">THIS FOLDER</div><h3 class="tf-card-title">Backups</h3></div></div>
            @if (Model.Backups.Count == 0)
            {
                <div class="card-body text-secondary">No backups in this folder yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead><tr><th>Created</th><th>Size</th><th>Journals</th><th>Trades</th><th>Images</th><th>Version</th><th>File</th></tr></thead>
                        <tbody>
                            @foreach (var backup in Model.Backups)
                            {
                                var sidecar = backup.Sidecar;
                                <tr>
                                    <td>@Local(sidecar.CreatedUtc)@(sidecar.Trigger == BackupTrigger.Manual ? " · manual" : string.Empty)@(sidecar.Encrypted ? " · encrypted" : string.Empty)@(backup.FromThisInstallation ? string.Empty : " · other installation")</td>
                                    <td>@BackupsModel.FormatBytes(sidecar.Size)</td>
                                    <td>@sidecar.Counts.GetValueOrDefault("journals")</td>
                                    <td>@sidecar.Counts.GetValueOrDefault("trades").ToString("N0", CultureInfo.InvariantCulture)</td>
                                    <td>@sidecar.Counts.GetValueOrDefault("images").ToString("N0", CultureInfo.InvariantCulture)</td>
                                    <td>@sidecar.AppVersion</td>
                                    <td class="text-break small">@sidecar.Archive@if (sidecar.Warnings.Count > 0) {<div class="text-warning">@string.Join(" ", sidecar.Warnings)</div>}</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-12">
        <div class="card tf-card">
            <div class="card-header"><div><div class="tf-kicker">HISTORY</div><h3 class="tf-card-title">Recent runs</h3></div></div>
            @if (Model.Runs.Count == 0)
            {
                <div class="card-body text-secondary">No backups have run yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead><tr><th>Started</th><th>Result</th><th>Paused</th><th>Details</th></tr></thead>
                        <tbody>
                            @foreach (var run in Model.Runs)
                            {
                                <tr>
                                    <td>@Local(run.StartedUtc)</td>
                                    <td class="@BackupsModel.StatusClass(run.Status)">@BackupsModel.StatusLabel(run.Status)</td>
                                    <td>@(run.MaintenanceMilliseconds is { } ms ? $"{ms / 1000d:0.0} s" : "–")</td>
                                    <td class="small text-break">
                                        @run.Message@foreach (var warning in run.Warnings) {<div class="text-warning">@warning</div>}
                                        @if (!string.IsNullOrEmpty(run.CloudMessage))
                                        {
                                            <div class="@(run.CloudStatus == BackupCloudStatus.Failed ? "text-danger" : "text-secondary")">@run.CloudMessage</div>
                                        }
                                        @if (run.CloudStatus == BackupCloudStatus.Failed && Model.Cloud is not null && !Model.Progress.Running)
                                        {
                                            <form method="post" action="@($"{journalPath}?handler=RetryUpload")" class="mt-1">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="runId" value="@run.Id" />
                                                <button class="btn btn-sm btn-outline-primary" type="submit">Upload again</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    <div class="col-12">
        <div class="card tf-card border-danger">
            <div class="card-header"><div><div class="tf-kicker text-danger">START CLEAN</div><h3 class="tf-card-title">Move current data aside and start clean</h3></div></div>
            <div class="card-body">
                <p class="text-secondary small">Moves the database, images, receipts and image settings into a set-aside folder inside the data directory, then restarts with an empty installation that keeps your owner account. Use it before restoring a backup over this installation. Nothing is deleted: while no journal exists, the restore page offers to put the data back.</p>
                <form method="post" action="@($"{journalPath}?handler=StartClean")" class="row g-3" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <div class="col-md-4"><label class="form-label" for="start-clean-password">Owner password</label><input class="form-control" id="start-clean-password" name="CurrentPassword" type="password" autocomplete="current-password" /></div>
                    <div class="col-md-4"><label class="form-label" for="start-clean-confirm">Type "@BackupsModel.StartCleanPhrase"</label><input class="form-control" id="start-clean-confirm" name="confirmation" /></div>
                    <div class="col-md-4 d-flex align-items-end"><button class="btn btn-outline-danger" type="submit" onclick="return confirm('Move all journals aside and restart with an empty installation?');">Start clean</button></div>
                </form>
                <p class="text-secondary small mt-3 mb-0">Consider backing up first, so the data is also somewhere outside this machine's data directory.</p>
            </div>
        </div>
    </div></section>
