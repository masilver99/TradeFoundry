{
  "Storage": {
    "DataDirectory": ".tradefoundry-data",
    "DatabaseFileName": "journal.db"
  },
  "Benchmark": {
    "AutomaticRefresh": true,
    "DefaultSymbol": "^GSPC",
    "RefreshIntervalMinutes": 1440,
    "RequestTimeoutSeconds": 10,
    "StartPaddingDays": 7,
    "EndPaddingDays": 2,
    "UseAdjustedClose": true,
    "YahooChartBaseUrl": "https://query2.finance.yahoo.com/"
  },
  "Mcp": {
    "Enabled": true,
    "Url": "http://127.0.0.1:5081",
    "RequestsPerMinute": 60,
    "MaxConcurrentAnalysis": 4
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
