@page "/journal/{journalId:guid}/settings/instruments"
@model TradeFoundry.Pages.Settings.InstrumentsModel
@using System.Globalization
@{
    ViewData["Title"] = "Instrument settings";
    ViewData["PageKicker"] = "TRADEFOUNDRY / SETTINGS / INSTRUMENTS";
    ViewData["ActiveNav"] = "settings";
    ViewData["SettingsSection"] = "instruments";
}

@await Html.PartialAsync("_SettingsNav", Model.JournalId)

@if (!string.IsNullOrWhiteSpace(Model.FlashMessage))
{
    <div class="alert tf-alert @(Model.FlashKind == "error" ? "error" : string.Empty)" role="status">@Model.FlashMessage</div>
}

<div class="tf-settings-intro">
    <div>
        <div class="tf-kicker">NORMALIZATION</div>
        <h3 class="tf-settings-heading">Instrument definitions</h3>
        <p class="text-secondary mb-0">These values are stored with normalized fills and trades. Use the optional fee breakdown when you want Exchange, NFA, and Clearing / commission tracked separately. The dashboard and reports aggregate each component across all applicable fills. The legacy commission field remains available for a single all-in amount.</p>
    </div>
</div>

<div class="card tf-card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-vcenter tf-table">
                <thead><tr><th>Instrument</th><th>All-in fallback</th><th>Fee components / contract</th><th>Point value</th><th>Tick size</th><th></th></tr></thead>
                <tbody>
                @foreach (var instrument in Model.Instruments)
                {
                    <tr>
                        <td colspan="6">
                            <form method="post" action="@($"/journal/{Model.JournalId:D}/settings/instruments?handler=SaveInstrument")" class="row g-2 align-items-end">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="journalId" value="@Model.JournalId" />
                                <input type="hidden" name="instrumentId" value="@instrument.Id" />
                                <div class="col-sm-3"><label class="form-label">Code<input class="form-control form-control-sm" name="code" value="@instrument.Code" required maxlength="32" /></label></div>
                                <div class="col-sm-2"><label class="form-label">All-in / contract<input class="form-control form-control-sm" name="defaultCommission" type="number" step="0.01" min="0" value="@(instrument.DefaultCommission?.ToString("0.########", CultureInfo.InvariantCulture))" placeholder="Imported fee" /></label></div>
                                <div class="col-sm-4"><fieldset class="tf-review-fieldset"><legend>Fee components / contract</legend><div class="row g-1"><div class="col-4"><input class="form-control form-control-sm" name="exchangeFeePerContract" type="number" step="0.01" min="0" value="@(instrument.ExchangeFeePerContract?.ToString("0.########", CultureInfo.InvariantCulture))" placeholder="Exchange" aria-label="Exchange fee per contract" /></div><div class="col-4"><input class="form-control form-control-sm" name="nfaFeePerContract" type="number" step="0.01" min="0" value="@(instrument.NfaFeePerContract?.ToString("0.########", CultureInfo.InvariantCulture))" placeholder="NFA" aria-label="NFA fee per contract" /></div><div class="col-4"><input class="form-control form-control-sm" name="clearingFeePerContract" type="number" step="0.01" min="0" value="@(instrument.ClearingFeePerContract?.ToString("0.########", CultureInfo.InvariantCulture))" placeholder="Clearing / commission" aria-label="Clearing / commission fee per contract" /></div></div></fieldset></div>
                                <div class="col-sm-2"><label class="form-label">$/point<input class="form-control form-control-sm" name="pointValue" type="number" step="0.000001" min="0.000001" value="@instrument.PointValue.ToString("0.########", CultureInfo.InvariantCulture)" required /></label></div>
                                <div class="col-sm-2"><label class="form-label">Tick size<input class="form-control form-control-sm" name="tickSize" type="number" step="0.000001" min="0" value="@instrument.TickSize.ToString("0.########", CultureInfo.InvariantCulture)" /></label></div>
                                <div class="col-sm-2 d-flex gap-2"><button class="btn btn-sm btn-primary" type="submit">Save</button><button class="btn btn-sm btn-outline-danger" type="submit" formaction="@($"/journal/{Model.JournalId:D}/settings/instruments?handler=DeleteInstrument")" formmethod="post" name="instrumentId" value="@instrument.Id" onclick="return confirm('Remove this instrument?');">Remove</button></div>
                            </form>
                        </td>
                    </tr>
                }
                <tr>
                    <td colspan="6">
                        <div class="tf-kicker mb-2">ADD INSTRUMENT</div>
                        <form method="post" action="@($"/journal/{Model.JournalId:D}/settings/instruments?handler=SaveInstrument")" class="row g-2 align-items-end">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="journalId" value="@Model.JournalId" />
                            <div class="col-sm-3"><label class="form-label">Code<input class="form-control form-control-sm" name="code" placeholder="e.g. ZB" required maxlength="32" /></label></div>
                            <div class="col-sm-2"><label class="form-label">All-in / contract<input class="form-control form-control-sm" name="defaultCommission" type="number" step="0.01" min="0" placeholder="Optional" /></label></div>
                            <div class="col-sm-4"><fieldset class="tf-review-fieldset"><legend>Fee components / contract</legend><div class="row g-1"><div class="col-4"><input class="form-control form-control-sm" name="exchangeFeePerContract" type="number" step="0.01" min="0" placeholder="Exchange" aria-label="Exchange fee per contract" /></div><div class="col-4"><input class="form-control form-control-sm" name="nfaFeePerContract" type="number" step="0.01" min="0" placeholder="NFA" aria-label="NFA fee per contract" /></div><div class="col-4"><input class="form-control form-control-sm" name="clearingFeePerContract" type="number" step="0.01" min="0" placeholder="Clearing / commission" aria-label="Clearing / commission fee per contract" /></div></div></fieldset></div>
                            <div class="col-sm-2"><label class="form-label">$/point<input class="form-control form-control-sm" name="pointValue" type="number" step="0.000001" min="0.000001" placeholder="e.g. 31.25" required /></label></div>
                            <div class="col-sm-2"><label class="form-label">Tick size<input class="form-control form-control-sm" name="tickSize" type="number" step="0.000001" min="0" placeholder="Optional" /></label></div>
                            <div class="col-sm-2"><button class="btn btn-sm btn-outline-primary" type="submit">Add instrument</button></div>
                        </form>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
