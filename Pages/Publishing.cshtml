@page "/journal/{journalId:guid}/publishing"
@model TradeFoundry.Pages.PublishingModel
@{
    ViewData["Title"] = "Publishing";
    ViewData["ActiveNav"] = "publishing";
    ViewData["UsesLexical"] = true;
    var draft = Model.State.Draft;
}
<div class="mb-4"><div class="tf-kicker">PUBLIC JOURNAL</div><h2>Publish @Model.Journal!.Name</h2>
<p class="text-secondary">Publish this journal’s entire history: realized statistics, daily writing, embedded images, and five-minute trade charts with entry and exit prices where bar data is available. Anyone can view the website. Local changes appear only after another preview and publication.</p></div>
@if (Model.Error is not null) { <div class="alert alert-danger" role="alert" data-notification-exclude>@Model.Error</div> }
@if (Model.Message is not null) { <div class="alert alert-success" role="status" data-notification-exclude>@Model.Message</div> }
<div class="row row-cards">
<section class="col-lg-6"><div class="card"><div class="card-body"><h3>Website settings</h3>
<form method="post" asp-page-handler="Save">
<div class="mb-3"><label class="form-label" asp-for="DestinationUrl">Destination URL</label><input class="form-control" asp-for="DestinationUrl" type="url" required placeholder="https://journal.example.com/" /></div>
<div class="mb-3"><label class="form-label" for="PublishingToken">Publishing token</label><input class="form-control" id="PublishingToken" name="PublishingToken" type="password" value="" autocomplete="new-password" maxlength="4096" /><small class="text-secondary">@(Model.State.ProtectedToken.Length > 0 ? "A protected token is saved. Leave blank to keep it." : "Use the token configured on the website server.")</small></div>
<div class="mb-3"><label class="form-label" asp-for="PublicTitle">Title</label><input class="form-control" asp-for="PublicTitle" required maxlength="150" /></div>
<div class="mb-3"><label id="publishing-introduction-label" class="form-label" asp-for="Introduction">Introduction</label>
<div class="tf-lexical-editor" data-lexical-editor data-max-length="64000" hidden>
            <div class="tf-lexical-toolbar" role="toolbar" aria-label="Introduction formatting">
                <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="bold" title="Bold" aria-label="Bold"><strong>B</strong></button>
                <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="italic" title="Italic" aria-label="Italic"><em>I</em></button>
                <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="heading" title="Heading" aria-label="Heading">H</button>
                <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="link" title="Link" aria-label="Link">↗</button>
                <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="unordered-list" title="Bullet list" aria-label="Bullet list">•</button>
                <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="ordered-list" title="Numbered list" aria-label="Numbered list">1.</button>
                <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="quote" title="Quote" aria-label="Quote">❯</button>
                <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="code" title="Inline code" aria-label="Inline code">&lt;/&gt;</button>
                <span class="tf-lexical-toolbar-spacer"></span>
                <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="undo" title="Undo" aria-label="Undo">↶</button>
                <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="redo" title="Redo" aria-label="Redo">↷</button>
            </div>
            <div class="tf-lexical-root" data-lexical-root contenteditable="true" role="textbox" aria-multiline="true" aria-labelledby="publishing-introduction-label" data-placeholder="Introduce your public trading journal."></div>
            <small class="tf-lexical-limit-status" data-lexical-limit-status aria-live="polite"></small>

</div>
<textarea class="form-control" asp-for="Introduction" rows="7" maxlength="64000" data-lexical-source></textarea>
<small class="text-secondary">Appears below the title and timezone on your public journal. Save settings before creating a preview.</small></div>
<button type="submit" class="btn btn-primary">Save settings</button><small class="text-secondary ms-2">Saving clears the current preview.</small>
</form></div></div></section>
<section class="col-lg-6"><div class="card"><div class="card-body"><h3>Publication status</h3>
<dl><dt>Last successful publication</dt><dd>@(Model.State.LastSuccessUtc?.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "Never published from this journal")</dd>
<dt>Last observed website status</dt><dd>@(Model.State.RemoteStatus is { } status ? $"Revision {status.Revision} · {(status.SnapshotId.HasValue ? "Published" : "Unpublished")}" : "Not checked")</dd></dl>
@if (Model.State.RemoteStatus?.BoundJournalId is { } bound && bound != Model.JournalId) { <p class="text-danger">This website is bound to another journal.</p> }
<div class="d-flex flex-wrap gap-2"><form method="post" asp-page-handler="Status"><button class="btn" type="submit">Refresh status</button></form>
<form method="post" asp-page-handler="Preview"><button class="btn btn-primary" type="submit">Create preview</button></form></div>
<p class="text-secondary small mt-3">Preview uses saved settings and includes all daily journal entries. Account identifiers, imports, private trade reviews, and receipts are excluded.</p>
@if (Model.State.RemoteStatus is { } remote)
{
<hr /><form method="post" asp-page-handler="Unpublish"><input type="hidden" name="expectedRevision" value="@remote.Revision" />
<label class="form-check mb-3"><input class="form-check-input" type="checkbox" name="resetBinding" value="true" /><span class="form-check-label">Also reset the journal binding so another journal can use this website.</span></label>
<button class="btn btn-outline-danger" type="submit">Unpublish website</button></form>
}
</div></div></section>
</div>
@if (draft is not null)
{
<section class="card mt-4"><div class="card-body"><h3>Review the outgoing snapshot</h3>
<p>Prepared @draft.Snapshot.GeneratedUtc.ToString("yyyy-MM-dd HH:mm 'UTC'") · @draft.Snapshot.Days.Count days · @draft.Snapshot.Dashboard.CompletedTrades trades · @draft.Snapshot.Images.Count images</p>
@if (draft.Snapshot.Days.Count > 0) { <p class="text-secondary">Coverage: @draft.Snapshot.Days.Min(d => d.Date).ToString("yyyy-MM-dd") to @draft.Snapshot.Days.Max(d => d.Date).ToString("yyyy-MM-dd").</p> }
<p class="text-secondary">The preview below contains the complete publication. Later local edits will not change this snapshot.</p>
<a class="btn mb-3" target="_blank" rel="noopener" href="?handler=PreviewDocument&amp;snapshotId=@draft.Snapshot.SnapshotId">Open full preview</a>
<iframe title="Complete public journal preview" src="?handler=PreviewDocument&amp;snapshotId=@draft.Snapshot.SnapshotId" class="w-100 border rounded" height="760" sandbox="allow-same-origin allow-scripts"></iframe>
<form method="post" asp-page-handler="Publish" class="mt-3"><input type="hidden" name="snapshotId" value="@draft.Snapshot.SnapshotId" /><button class="btn btn-success" type="submit">Publish this exact snapshot</button></form>
</div></section>
}
