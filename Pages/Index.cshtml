@page
@model TradeFoundry.Pages.IndexModel
@using TradeFoundry.Core
@{
    ViewData["Title"] = "Overview";
    ViewData["PageKicker"] = "TRADEFOUNDRY / WORKSPACE";
    ViewData["ActiveNav"] = "overview";
    ViewData["UsesPlotly"] = Model.Overview is not null;
}

@if (!string.IsNullOrWhiteSpace(Model.FlashMessage))
{
    <div class="alert tf-alert @(Model.FlashKind == "warning" ? "warning" : Model.FlashKind == "error" ? "error" : string.Empty)" role="status">@Model.FlashMessage</div>
}

@if (Model.Overview is null)
{
    <div class="row justify-content-center">
        <div class="col-xl-8">
            <section class="card tf-card tf-auth-card">
                <div class="card-body p-4 p-md-5">
                    <div class="tf-kicker">FIRST JOURNAL</div>
                    <h1 class="tf-hero-title">Start with a clean ledger.</h1>
                    <p class="tf-lede mb-4">Create a journal, then import Sierra Chart, TradingView, or OHLCV evidence into this local workspace.</p>
                    <form method="post" action="/?handler=CreateJournal" class="row g-3">
                        @Html.AntiForgeryToken()
                        <div class="col-md-6"><label class="form-label">Name<input asp-for="NewJournalName" class="form-control" placeholder="e.g. ES Opening Range" required /></label></div>
                        <div class="col-md-6"><label class="form-label">Execution context<select asp-for="NewExecutionContext" class="form-select"><option value="live">Live</option><option value="paper">Paper</option><option value="replay">Replay</option><option value="backtest">Backtest</option><option value="other">Other</option></select></label></div>
                        <div class="col-md-6"><label class="form-label">Labels<input asp-for="NewLabels" class="form-control" placeholder="algo, ORB, experimental" /></label></div>
                        <div class="col-md-6"><label class="form-label">Timezone<input asp-for="NewTimeZone" class="form-control" /></label></div>
                        <div class="col-md-6"><label class="form-label">Currency<input asp-for="NewCurrency" class="form-control" /></label></div>
                        <div class="col-md-6"><label class="form-label">Grouping<select asp-for="NewGroupingPolicy" class="form-select"><option value="flat_to_flat">Flat-to-flat</option><option value="fifo_lots">FIFO lots (phase 2)</option></select></label></div>
                        <div class="col-md-6"><label class="form-label">Starting equity <span class="text-secondary">(optional)</span><input asp-for="NewStartingEquity" class="form-control" type="number" step="0.01" min="0" placeholder="e.g. 18000" /></label></div>
                        <div class="col-12"><button class="btn btn-primary" type="submit">Create journal</button></div>
                    </form>
                </div>
            </section>
        </div>
    </div>
}
else
{
    var overview = Model.Overview;
    var account = Model.Account;
    var accountBalance = account?.CurrentBalance;
    var accountProfit = account?.RealizedProfit ?? 0m;
    var accountTwr = account?.RealizedTwrPercent;
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a class="btn btn-primary" href="@($"/journal/{overview.Journal.Id:D}/imports")">Import records</a>
        <a class="btn btn-outline-secondary" href="@($"/journal/{overview.Journal.Id:D}/trades")">Open trade ledger</a>
        <a class="btn btn-outline-secondary" href="@($"/journal/{overview.Journal.Id:D}/account")">Account</a>
        <a class="btn btn-outline-secondary" href="@($"/journal/{overview.Journal.Id:D}/settings")">Journal settings</a>
    </div>

    <section class="row row-cards mb-3" aria-label="Journal metrics">
        <div class="col-sm-6 col-xl-2"><a class="card tf-card tf-metric tf-metric-account tf-account-summary-card d-block" href="@($"/journal/{overview.Journal.Id:D}/account")"><div class="card-body"><div class="tf-metric-label">Account balance</div><div class="tf-metric-value @(accountBalance.HasValue && accountBalance.Value < 0m ? "negative" : "positive")">@(accountBalance?.ToString("C2") ?? "—")</div><div class="tf-metric-note">@(accountTwr.HasValue ? $"{accountTwr.Value:+0.00;-0.00;0.00}% realized TWR · {accountProfit:C2} profit" : $"{accountProfit:C2} realized · TWR unavailable")</div><div class="tf-account-card-link">Open account ledger →</div></div></a></div>
        <div class="col-sm-6 col-xl-2"><div class="card tf-card tf-metric tf-metric-accent"><div class="card-body"><div class="tf-metric-label">Net P&amp;L</div><div class="tf-metric-value @(overview.NetPnl >= 0 ? "positive" : "negative")">@overview.NetPnl.ToString("C2")</div><div class="tf-metric-note">All imported trades</div></div></div></div>
        <div class="col-sm-6 col-xl-2"><div class="card tf-card tf-metric"><div class="card-body"><div class="tf-metric-label">Points</div><div class="tf-metric-value">@overview.Points.ToString("0.##")</div><div class="tf-metric-note">Direction-adjusted</div></div></div></div>
        <div class="col-sm-6 col-xl-2"><div class="card tf-card tf-metric"><div class="card-body"><div class="tf-metric-label">Closed trades</div><div class="tf-metric-value">@overview.ClosedTradeCount</div><div class="tf-metric-note">@overview.OpenTradeCount open</div></div></div></div>
        <div class="col-sm-6 col-xl-2"><div class="card tf-card tf-metric"><div class="card-body"><div class="tf-metric-label">Win rate</div><div class="tf-metric-value">@overview.WinRate.ToString("0.0")%</div><div class="tf-metric-note">@overview.WinningTrades wins · @overview.LosingTrades losses</div></div></div></div>
        <div class="col-sm-6 col-xl-2"><div class="card tf-card tf-metric"><div class="card-body"><div class="tf-metric-label">Profit factor</div><div class="tf-metric-value">@(overview.ProfitFactor == decimal.MaxValue ? "∞" : overview.ProfitFactor.ToString("0.00"))</div><div class="tf-metric-note">Winners ÷ losers</div></div></div></div>
        <div class="col-sm-6 col-xl-2"><div class="card tf-card tf-metric"><div class="card-body"><div class="tf-metric-label">Fees</div><div class="tf-metric-value">@overview.Fees.ToString("C2")</div><div class="tf-metric-note">Exchange @overview.ExchangeFees.ToString("C2") · NFA @overview.NfaFees.ToString("C2") · Clearing @overview.ClearingFees.ToString("C2")<br /><span class="text-secondary">All-in overrides are included in total</span></div></div></div></div>
    </section>

    <section class="row row-cards mb-3">
        <div class="col-lg-6">
            <div class="card tf-card tf-chart-card">
                <div class="card-header">
                    <div class="tf-section-heading">
                        <div>
                            <h3 class="tf-card-title">Equity Curve</h3>
                            <span class="text-secondary" data-equity-view-label aria-live="polite">@(Model.ShowDailyEquity ? "Daily" : "by trade")</span>
                        </div>
                        <form method="get" class="tf-equity-view-toggle" data-equity-toggle-form>
                            <input type="hidden" name="journalId" value="@overview.Journal.Id" />
                            <label class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" name="daily" value="true" checked="@(Model.ShowDailyEquity ? "checked" : null)" onchange="this.form.requestSubmit()" aria-label="@(Model.ShowDailyEquity ? "Show equity curve by trade" : "Show Daily equity curve")" />
                                <span class="form-check-label">By Trade/Daily</span>
                            </label>
                            <label class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" name="hideEmptyDays" value="true" checked="@(Model.HideEmptyEquityDays ? "checked" : null)" disabled="@(Model.ShowDailyEquity ? null : "disabled")" onchange="this.form.requestSubmit()" aria-label="Hide days without trades from the Daily equity curve" />
                                <span class="form-check-label">Hide days without trades</span>
                            </label>
                        </form>
                    </div>
                </div>
                <div class="card-body"><div data-equity-chart-host>@Html.Raw(Model.EquityChart)</div></div>
            </div>
        </div>
        <div class="col-lg-6"><div class="card tf-card tf-chart-card"><div class="card-header"><div class="tf-section-heading"><div><h3 class="tf-card-title">Daily result</h3></div><span class="text-secondary">last 180 days</span></div></div><div class="card-body">@Html.Raw(Model.DailyChart)</div></div></div>
    </section>

    <section class="row row-cards">
        <div class="col-xl-8"><div class="card tf-card"><div class="card-header"><div class="tf-section-heading"><div><h3 class="tf-card-title">Trade Ledger</h3></div><a class="btn btn-sm btn-outline-secondary" href="@($"/journal/{overview.Journal.Id:D}/trades")">View all</a></div></div><div class="card-body p-0"><div class="tf-table-wrap">@if (overview.RecentTrades.Count == 0){<div class="tf-empty m-3"><strong>No trades yet.</strong>Import an export to start the ledger.</div>}else{<table class="table table-vcenter tf-table"><thead><tr><th>Entry</th><th>Instrument / symbol</th><th>Side</th><th>Qty</th><th>Net P&amp;L</th><th>Status</th></tr></thead><tbody>@foreach (var trade in overview.RecentTrades){var reviewTimestamp = trade.ExitUtc.HasValue && trade.Status.Equals("closed", StringComparison.OrdinalIgnoreCase) ? trade.ExitUtc.Value : trade.EntryUtc; var reviewDate = TimeZoneCatalog.Format(reviewTimestamp, overview.Journal.TimeZone, "yyyy-MM-dd"); var reviewUrl = $"/journal/{trade.JournalId:D}/review?date={reviewDate}&focus={Uri.EscapeDataString(trade.ReviewKey)}"; <tr><td><a class="row-link" href="@reviewUrl">@TimeZoneCatalog.Format(trade.EntryUtc, overview.Journal.TimeZone, "MMM d, HH:mm")</a></td><td><strong>@trade.Instrument</strong><small>@trade.Symbol · @trade.Account</small></td><td><span class="tf-side @(trade.Direction.Equals("Short", StringComparison.OrdinalIgnoreCase) ? "tf-side-short" : "tf-side-long")">@trade.Direction</span></td><td>@trade.ClosedQuantity/@trade.Quantity</td><td class="@(trade.NetPnl >= 0 ? "positive" : "negative")">@trade.NetPnl.ToString("C2")</td><td><span class="tf-status @(trade.Status.Equals("closed", StringComparison.OrdinalIgnoreCase) ? "tf-status-closed" : "tf-status-open")">@trade.Status</span></td></tr>}</tbody></table>}</div></div></div></div>
        <div class="col-xl-4"><div class="card tf-card"><div class="card-header"><div class="tf-section-heading"><div><div class="tf-kicker">PROVENANCE</div><h3 class="tf-card-title">Recent imports</h3></div><a class="btn btn-sm btn-outline-secondary" href="@($"/journal/{overview.Journal.Id:D}/imports")">View all</a></div></div><div class="card-body">@if (overview.RecentImports.Count == 0){<div class="tf-empty"><strong>No imports yet.</strong>Your import history will appear here.</div>}else{foreach (var batch in overview.RecentImports){<div class="tf-import-row"><div><strong>@batch.FileName</strong><small>@TradeFoundryConstants.SourceApplicationName(batch.SourceApplication) · @TimeZoneCatalog.Format(batch.ImportedUtc, overview.Journal.TimeZone, "MMM d, yyyy HH:mm")</small></div><div class="tf-import-count">@batch.NewRows new<br />@batch.DuplicateRows dup</div></div>}}</div></div></div>
    </section>
}
