@page
@model TradeFoundry.Pages.TradeModel
@{
    ViewData["Title"] = "Trade detail";
    var trade = Model.Trade!;
}
<div class="page-shell detail-shell">
    <a class="back-link" asp-page="/Index" asp-route-journalId="@trade.JournalId">← Back to @Model.Journal?.Name</a>
    <section class="detail-heading">
        <div><p class="eyebrow">TRADE DETAIL / @trade.Status.ToUpperInvariant()</p><h1>@trade.Direction @trade.Symbol <span class="muted">× @trade.ClosedQuantity</span></h1><p class="lede">@trade.EntryUtc.ToLocalTime().ToString("dddd, MMMM d, yyyy · HH:mm") @(trade.ExitUtc.HasValue ? $"→ {trade.ExitUtc.Value.ToLocalTime():HH:mm}" : "· still open")</p></div>
        <div class="detail-pnl @(trade.NetPnl >= 0 ? "positive" : "negative")">@trade.NetPnl.ToString("C2")<small>net result</small></div>
    </section>
    <section class="detail-stats">
        <div><span>Entry</span><strong>@trade.EntryPrice.ToString("0.########")</strong></div><div><span>Exit</span><strong>@(trade.ExitPrice?.ToString("0.########") ?? "—")</strong></div><div><span>Avg points</span><strong>@trade.AveragePoints.ToString("0.##")</strong></div><div><span>Contract-points</span><strong>@trade.GrossPoints.ToString("0.##")</strong></div><div><span>MAE / MFE</span><strong>@(trade.MaePoints?.ToString("0.##") ?? "—") / @(trade.MfePoints?.ToString("0.##") ?? "—")</strong></div><div><span>Duration</span><strong>@(trade.Duration?.ToString("hh\\:mm\\:ss") ?? "—")</strong></div>
    </section>
    <section class="card-panel chart-card trade-chart"><div class="section-heading"><div><p class="eyebrow">CONTEXT</p><h2>Price action around the trade</h2></div><span class="muted">@Model.Bars.Count bars · entry/exit markers</span></div>@Html.Raw(Model.CandleChart)</section>
    <section class="split-grid"><article class="card-panel"><p class="eyebrow">PROVENANCE</p><h2>How this row was made</h2><dl class="definition-list"><dt>Source</dt><dd>@trade.SourceType</dd><dt>Grouping</dt><dd>@trade.GroupingPolicy</dd><dt>Account</dt><dd>@trade.Account</dd><dt>Import batch</dt><dd>@(trade.ImportBatchId?.ToString() ?? "manual / source-defined")</dd><dt>Note</dt><dd>@(string.IsNullOrWhiteSpace(trade.Note) ? "No source note" : trade.Note)</dd></dl></article><article class="card-panel phase-note"><p class="eyebrow">PHASE 2 PLACEHOLDER</p><h2>Review this trade.</h2><p>Manual notes, screenshots, setups, planned risk, and user-defined scorecards will attach here in the next stage. Phase 1 keeps this detail read-only so imported evidence remains auditable.</p></article></section>
</div>
