@page "/journal/{journalId:guid}/review"
@model TradeFoundry.Pages.ReviewModel
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using TradeFoundry.Core
@{
    ViewData["Title"] = "Trade Review";
    ViewData["PageKicker"] = "TRADEFOUNDRY / TRADE";
    ViewData["ActiveNav"] = "review";
    var selectedDate = Model.Date ?? Model.Day.Date;
    var dateText = selectedDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var allTrades = Model.DayTrades;
    var summary = Model.Day.Summary;
    var activeReviewKey = Model.ActiveTrade?.Trade.ReviewKey ?? string.Empty;
    ViewData["UsesLightweightCharts"] = allTrades.Length > 0;
    ViewData["UsesLexical"] = true;
    ViewData["ReviewModel"] = Model;
}

<section class="tf-review-shell" data-focus="@activeReviewKey" data-active-key="@activeReviewKey" data-review-section="@Model.Section" data-currency="@Model.Day.Journal.Currency">
<header class="tf-review-header"><div class="tf-review-roster-heading">
                    <div class="tf-review-roster-title-row">
                        <h2><time datetime="@dateText" aria-label="@selectedDate.ToString("dddd, MMMM d, yyyy", CultureInfo.InvariantCulture)">@selectedDate.ToString("ddd, M/d/yy", CultureInfo.InvariantCulture)</time></h2>
                        <div class="tf-review-day-nav" aria-label="Trading day navigation">
                            @if (Model.Day.PreviousDate.HasValue)
                            {
                                <a class="btn btn-sm btn-outline-secondary" title="Previous day (←)" aria-label="Previous day" asp-page="/Review" asp-route-journalId="@Model.JournalId" asp-route-date="@Model.Day.PreviousDate.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">←</a>
                            }
                            else
                            {
                                <span class="btn btn-sm btn-outline-secondary disabled" title="No previous day" aria-label="No previous day" aria-disabled="true">←</span>
                            }
                            @if (Model.Day.NextDate.HasValue)
                            {
                                <a class="btn btn-sm btn-outline-secondary" title="Next day (→)" aria-label="Next day" asp-page="/Review" asp-route-journalId="@Model.JournalId" asp-route-date="@Model.Day.NextDate.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">→</a>
                            }
                            else
                            {
                                <span class="btn btn-sm btn-outline-secondary disabled" title="No next day" aria-label="No next day" aria-disabled="true">→</span>
                            }
                        </div>
                    </div>
                    <div class="tf-review-roster-summary">
                        <span>@Model.Day.CompletedTradeCount completed</span>
                        <span>@Model.Day.OpenTradeCount open</span>
                        <strong data-review-day-pnl class="@(Model.Day.RealizedNetPnl >= 0 ? "text-success" : "text-danger")">@Model.Day.RealizedNetPnl.ToString("C2", CultureInfo.CurrentCulture)</strong>
                    </div>
                </div>
<div class="tf-review-header-metrics">
    <div><span>Worst MAE</span><strong data-review-day-mae title="@summary.MaeCoverage / @summary.CompletedCount completed trades have MAE">@(summary.WorstMae?.ToString("C2") ?? "—")</strong></div>
    <div title="Peak-to-trough closed-trade net P&amp;L decline, starting at zero; excludes intratrade equity."><span>Realized drawdown</span><strong data-review-day-drawdown>@summary.RealizedDrawdown.ToString("C2")</strong></div>
    <div><span>Review progress</span><strong data-review-day-progress aria-live="polite">@summary.ReviewedCount/@summary.TotalCount trades reviewed</strong></div>
</div>
<svg class="tf-review-sparkline" viewBox="0 0 180 48" role="img" aria-label="Cumulative realized net P&amp;L starting at zero" data-review-sparkline><line x1="0" x2="180" data-review-zero /><polyline fill="none" data-review-equity /></svg>
<script type="application/json" data-review-summary>@Html.Raw(System.Text.Json.JsonSerializer.Serialize(summary, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)))</script>
<button type="button" class="btn btn-outline-secondary" data-review-journal-open>
<span class="tf-review-indicator tf-daily-journal-indicator" data-review-daily-indicator hidden="@(!summary.HasDailyJournal)"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18M8 15h3M8 18h6"/></svg></span>
Daily journal <span class="visually-hidden" data-review-daily-state>@(summary.HasDailyJournal ? "populated" : "empty")</span></button>
<button type="button" class="btn btn-outline-secondary tf-review-shortcuts-button" data-review-shortcuts title="Keyboard shortcuts (?)" aria-label="Keyboard shortcuts">?</button></header>
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.NoticeMessage))
    {
        <div class="alert alert-success" role="status">@Model.NoticeMessage</div>
    }

<dialog id="review-journal-dialog" aria-labelledby="daily-journal-heading"><button type="button" class="btn" data-review-journal-close>Close</button><section class="card tf-card tf-daily-journal" data-daily-journal-entry data-entry-date="@dateText" aria-labelledby="daily-journal-heading">
        <div class="card-header tf-daily-journal-heading">
            <div class="tf-daily-journal-title">
                <h2 id="daily-journal-heading" class="tf-card-title">Daily journal</h2>
            </div>
        </div>
        <form id="daily-journal-editor" method="post" asp-page-handler="SaveDailyJournal" asp-route-journalId="@Model.JournalId" asp-route-date="@dateText" class="tf-daily-journal-form" data-daily-journal-form data-autosave-url="@Url.Page("/Review", "AutosaveDailyJournal", new { journalId = Model.JournalId, date = dateText })">
            @Html.AntiForgeryToken()
            <input type="hidden" name="expectedRevision" value="@Model.Day.DailyJournal.Revision" />
            <div class="tf-lexical-editor" data-lexical-editor data-max-length="64000" data-image-upload-url="/journal/@Model.JournalId/daily-journal?handler=UploadImage&amp;date=@dateText" hidden>
                <div class="tf-lexical-toolbar" role="toolbar" aria-label="Daily journal formatting">
                    <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="bold" title="Bold" aria-label="Bold"><strong>B</strong></button>
                    <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="italic" title="Italic" aria-label="Italic"><em>I</em></button>
                    <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="heading" title="Heading" aria-label="Heading">H</button>
                    <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="link" title="Link" aria-label="Link">↗</button>
                    <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="unordered-list" title="Bullet list" aria-label="Bullet list">•</button>
                    <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="ordered-list" title="Numbered list" aria-label="Numbered list">1.</button>
                    <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="quote" title="Quote" aria-label="Quote">❯</button>
                    <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="code" title="Inline code" aria-label="Inline code">&lt;/&gt;</button>
                    <span class="tf-lexical-toolbar-spacer"></span>
                    <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="undo" title="Undo" aria-label="Undo">↶</button>
                    <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="redo" title="Redo" aria-label="Redo">↷</button>
                </div>
                <div class="tf-lexical-root" data-lexical-root contenteditable="true" role="textbox" aria-multiline="true" aria-labelledby="daily-journal-label" data-placeholder="What happened today? Capture market context, your state of mind, and the lesson for tomorrow."></div>
                <small data-lexical-image-status role="status" aria-live="polite">Paste a PNG, JPEG, or WebP image (up to 10 MB).</small><small class="tf-lexical-limit-status" data-lexical-limit-status aria-live="polite"></small>
            </div>
            <label id="daily-journal-label" class="visually-hidden" for="daily-journal-text">Daily journal</label>
            <textarea id="daily-journal-text" name="dailyJournalStateJson" rows="7" maxlength="64000" data-lexical-source hidden>@Model.DailyJournalStateJson</textarea>
            <div class="tf-daily-journal-actions">
                <span class="tf-review-save-status" role="status" aria-live="polite" data-daily-journal-status>Saved</span>
            </div>
        </form>
    </section>

</dialog>
    @if (allTrades.Length == 0)
    {
        <div class="card tf-card tf-review-empty">
            <h2 class="h4">No trades on this date.</h2>
            <p class="mb-0 text-secondary">Use Previous day or Next day to jump between trading days.</p>
        </div>
    }

    else
    {
        <div class="tf-review-workspace" data-review-workspace>
            <aside class="card tf-card tf-review-roster" aria-label="Trades for selected day">
                            <div class="tf-review-roster-list" role="listbox" aria-label="Trades on selected day">
                    @{
                        var rosterIndex = 0;
                    }
                    @if (Model.Day.CompletedTrades.Count > 0)
                    {
                        <div class="tf-review-roster-group-label"><span>REALIZED</span><span>@Model.Day.CompletedTradeCount</span></div>
                        foreach (var item in Model.Day.CompletedTrades)
                        {
                            rosterIndex++;
                            var itemId = Model.DomId(item.Trade.ReviewKey);
                            var itemActive = item.Trade.ReviewKey == activeReviewKey;
                            <button type="button" class="tf-review-roster-item @(itemActive ? "is-active" : string.Empty)" data-review-select data-review-key="@item.Trade.ReviewKey" data-review-index="@rosterIndex" aria-controls="@itemId" aria-pressed="@(itemActive ? "true" : "false")">
                                <span class="tf-review-roster-item-top"><strong>@rosterIndex / @allTrades.Length</strong><span>@item.Trade.Symbol</span></span>
                                <span class="tf-review-roster-item-main"><span>@item.Trade.Direction · @item.Trade.Quantity qty</span><strong class="@(item.Trade.NetPnl >= 0 ? "text-success" : "text-danger")" data-review-roster-pnl>@item.Trade.NetPnl.ToString("C2", CultureInfo.CurrentCulture)</strong></span>
                                <span class="tf-review-roster-item-meta"><span>@Model.LocalTime(item.Trade.EntryUtc)</span>@await Html.PartialAsync("_ReviewIndicators", item.Trade)</span>
                            </button>
                        }
                    }
                    @if (Model.Day.OpenTrades.Count > 0)
                    {
                        <div class="tf-review-roster-group-label"><span>OPEN / UNREALIZED</span><span>@Model.Day.OpenTradeCount</span></div>
                        foreach (var item in Model.Day.OpenTrades)
                        {
                            rosterIndex++;
                            var itemId = Model.DomId(item.Trade.ReviewKey);
                            var itemActive = item.Trade.ReviewKey == activeReviewKey;
                            <button type="button" class="tf-review-roster-item @(itemActive ? "is-active" : string.Empty)" data-review-select data-review-key="@item.Trade.ReviewKey" data-review-index="@rosterIndex" aria-controls="@itemId" aria-pressed="@(itemActive ? "true" : "false")">
                                <span class="tf-review-roster-item-top"><strong>@rosterIndex / @allTrades.Length</strong><span>@item.Trade.Symbol</span></span>
                                <span class="tf-review-roster-item-main"><span>@item.Trade.Direction · @item.Trade.Quantity qty</span><strong class="text-secondary" data-review-roster-pnl>OPEN</strong></span>
                                <span class="tf-review-roster-item-meta"><span>@Model.LocalTime(item.Trade.EntryUtc)</span>@await Html.PartialAsync("_ReviewIndicators", item.Trade)</span>
                            </button>
                        }
                    }
                </div>
            </aside>

            <main class="tf-review-detail" aria-label="Selected trade editor">
                <div class="tf-review-editors">
                    @{
                        var editorIndex = 0;
                    }
                    @foreach (var item in allTrades)
                    {
                        editorIndex++;
                        var partialViewData = new ViewDataDictionary<DailyReviewTrade>(ViewData, item);
                        partialViewData["ReviewIndex"] = editorIndex;
                        partialViewData["ReviewCount"] = allTrades.Length;
                        partialViewData["ReviewActive"] = item.Trade.ReviewKey == activeReviewKey;
                        @await Html.PartialAsync("_ReviewTrade", item, partialViewData)
                    }
                </div>
            </main>
        </div>
    }
</section>
