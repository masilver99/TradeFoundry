@model TradeFoundry.Pages.DailyJournalCardViewModel
@using System.Globalization
@{
    var dateKey = Model.Entry.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var dateId = Model.Entry.Date.ToString("yyyyMMdd", CultureInfo.InvariantCulture);
    var formId = $"daily-journal-editor-{dateId}";
    var previewId = $"daily-journal-preview-{dateId}";
    var labelId = $"daily-journal-label-{dateId}";
}
<article id="daily-journal-@dateKey" class="card tf-card tf-daily-journal-entry @(Model.IsToday ? "is-today" : string.Empty)" data-daily-journal-entry data-entry-date="@dateKey" data-daily-journal-today="@Model.IsToday.ToString().ToLowerInvariant()" data-has-journal-text="@Model.HasJournalText.ToString().ToLowerInvariant()" aria-labelledby="daily-journal-heading-@dateId">
    <header class="tf-daily-journal-entry-header">
        <button type="button" class="tf-daily-journal-entry-toggle" data-daily-journal-toggle aria-controls="@formId @previewId" aria-expanded="@Model.OpenInitially.ToString().ToLowerInvariant()">
            <span class="tf-daily-journal-entry-summary" data-daily-journal-entry-summary>
                @if (Model.HasJournalText)
                {
                    <span class="tf-daily-journal-entry-check" data-daily-journal-entry-check aria-hidden="true">✓</span>
                }
                <span class="tf-daily-journal-entry-date">
                    @if (Model.IsToday)
                    {
                        <span class="tf-kicker">TODAY</span>
                    }
                    <span id="daily-journal-heading-@dateId" class="tf-card-title" role="heading" aria-level="2"><time datetime="@dateKey">@Model.Entry.Date.ToString("dddd, MMMM d, yyyy", CultureInfo.CurrentCulture)</time></span>
                </span>
                <span class="tf-daily-journal-day-stats">@Model.TradeCount.ToString("N0") @(Model.TradeCount == 1 ? "trade" : "trades") · @Model.RealizedNetPnl.ToString("C2", CultureInfo.CurrentCulture)</span>
            </span>
            <span class="tf-daily-journal-entry-meta">
                <span class="tf-daily-journal-bytes" data-daily-journal-bytes>@Model.TextBytes.ToString("N0", CultureInfo.CurrentCulture) @(Model.TextBytes == 1 ? "byte" : "bytes")</span>
                <span class="tf-daily-journal-toggle-icon" aria-hidden="true"></span>
            </span>
        </button>
        @if (Model.TradeCount > 0)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary tf-daily-journal-chart-trigger" data-daily-journal-chart data-daily-journal-chart-url="@Model.ChartUrl" aria-haspopup="dialog" aria-label="Open chart for @Model.Entry.Date.ToString("dddd, MMMM d, yyyy", CultureInfo.CurrentCulture)">Chart</button>
        }
    </header>
    <div id="@previewId" class="tf-daily-journal-preview" data-daily-journal-preview hidden="@(Model.OpenInitially || !Model.HasJournalText ? "hidden" : null)">
        <p>@Model.Preview</p>
    </div>
    <form id="@formId" method="post" action="@Model.SaveUrl" class="tf-daily-journal-form" data-daily-journal-form data-autosave-url="@Model.AutosaveUrl" hidden="@(Model.OpenInitially ? null : "hidden")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="expectedRevision" value="@Model.Entry.Revision" />
        <div class="tf-lexical-editor" data-lexical-editor data-max-length="64000" data-image-upload-url="@Model.ImageUploadUrl" hidden>
            <div class="tf-lexical-toolbar" role="toolbar" aria-label="Daily journal formatting">
                <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="bold" title="Bold" aria-label="Bold"><strong>B</strong></button>
                <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="italic" title="Italic" aria-label="Italic"><em>I</em></button>
                <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="heading" title="Heading" aria-label="Heading">H</button>
                <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="link" title="Link" aria-label="Link">↗</button>
                <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="unordered-list" title="Bullet list" aria-label="Bullet list">•</button>
                <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="ordered-list" title="Numbered list" aria-label="Numbered list">1.</button>
                <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="quote" title="Quote" aria-label="Quote">❯</button>
                <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="code" title="Inline code" aria-label="Inline code">&lt;/&gt;</button>
                <span class="tf-lexical-toolbar-spacer"></span>
                <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="undo" title="Undo" aria-label="Undo">↶</button>
                <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="redo" title="Redo" aria-label="Redo">↷</button>
            </div>
            <div class="tf-lexical-root" data-lexical-root contenteditable="true" role="textbox" aria-multiline="true" aria-labelledby="@labelId" data-placeholder="What happened today? Capture market context, your state of mind, and the lesson for tomorrow."></div>
            <small class="tf-lexical-limit-status" data-lexical-limit-status aria-live="polite"></small>
            <small class="tf-lexical-image-status" data-lexical-image-status role="status" aria-live="polite">Paste a PNG, JPEG, or WebP image into the journal; images can be up to 10 MB.</small>
        </div>
        <label id="@labelId" class="visually-hidden" for="@formId-text">Daily journal entry for @dateKey</label>
        <textarea id="@formId-text" name="dailyJournalStateJson" rows="7" maxlength="64000" data-lexical-source hidden>@Model.Entry.Text</textarea>
        <div class="tf-daily-journal-actions">
            <span class="tf-daily-journal-revision" data-daily-journal-revision>Revision @Model.Entry.Revision</span>
            <span class="tf-review-save-status" role="status" aria-live="polite" data-daily-journal-status>Saved</span>
        </div>
    </form>
</article>
