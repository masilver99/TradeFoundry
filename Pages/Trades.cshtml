@page "/journal/{journalId:guid}/trades"
@model TradeFoundry.Pages.TradesModel
@using TradeFoundry.Core
@{
    ViewData["Title"] = "Trade Ledger";
    ViewData["PageKicker"] = "TRADEFOUNDRY / TRADE";
    ViewData["ActiveNav"] = "trades";
    var action = $"/journal/{Model.JournalId:D}/trades";
    var filterQuery = Model.Filter.Filter.ToQueryString();
    var filterSuffix = filterQuery.Length == 0 ? string.Empty : "&" + filterQuery;
    var hasRefinements = !string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Symbol) || !string.IsNullOrWhiteSpace(Model.Status);
    var currentYear = TimeZoneCatalog.Convert(DateTimeOffset.UtcNow, Model.Journal?.TimeZone).Year;
    // Year only when it is not the current one, so rows stay on a single line.
    string EntryLabel(Trade trade) => TimeZoneCatalog.Convert(trade.EntryUtc, Model.Journal?.TimeZone).Year == currentYear
        ? TimeZoneCatalog.Format(trade.EntryUtc, Model.Journal?.TimeZone, "MMM d HH:mm")
        : TimeZoneCatalog.Format(trade.EntryUtc, Model.Journal?.TimeZone, "MMM d, yyyy HH:mm");
}

<section class="card tf-card mb-3">
    <div class="card-body">
        <form method="get" action="@action" class="tf-toolbar tf-ledger-filters" data-ledger-filters aria-label="Ledger search">
            @foreach (var item in Model.Filter.Filter.ToQuery())
            {
                <input type="hidden" name="@item.Key" value="@item.Value" />
            }
            <div class="tf-toolbar-fields">
                <div class="tf-filter tf-filter-wide"><label class="tf-filter-label" for="trade-search">Search</label><input id="trade-search" class="form-control form-control-sm" name="search" value="@Model.Search" placeholder="Symbol, account, side…" /></div>
                <div class="tf-filter"><label class="tf-filter-label" for="trade-symbol">Symbol</label><input id="trade-symbol" class="form-control form-control-sm" name="symbol" value="@Model.Symbol" placeholder="ES, NQ…" /></div>
                <div class="tf-filter"><label class="tf-filter-label" for="trade-status">Status</label><select id="trade-status" class="form-select form-select-sm" name="status"><option value="">All statuses</option><option value="closed" selected="@(Model.Status == "closed")">Closed</option><option value="open" selected="@(Model.Status == "open")">Open</option></select></div>
                <div class="tf-filter"><label class="tf-filter-label" for="trade-sort">Sort</label><select id="trade-sort" class="form-select form-select-sm" name="sort"><option value="entry_desc" selected="@(Model.Sort == "entry_desc")">Newest first</option><option value="entry_asc" selected="@(Model.Sort == "entry_asc")">Oldest first</option><option value="pnl_desc" selected="@(Model.Sort == "pnl_desc")">P&amp;L high to low</option><option value="pnl_asc" selected="@(Model.Sort == "pnl_asc")">P&amp;L low to high</option></select></div>
            </div>
            <div class="d-flex gap-2"><button class="btn btn-primary btn-sm" type="submit" data-ledger-apply>Apply filters</button><a class="btn btn-outline-secondary btn-sm" href="@action">Clear search</a></div>
        </form>
    </div>
</section>

<section class="card tf-card" data-ledger-results>
    <div class="card-header"><div class="tf-section-heading"><div><div class="tf-kicker">@Model.Journal?.Name</div><h3 class="tf-card-title">Trade ledger</h3></div><span class="text-secondary">@Model.Results.TotalCount.ToString("N0") matching trade(s)@(Model.Filter.IsActive ? $" · {Model.Filter.Summary}" : string.Empty)</span></div></div>
    <div class="card-body p-0">
        @if (Model.Results.Items.Count == 0)
        {
            <div class="tf-empty m-3"><strong>No matching trades.</strong>@if (Model.Filter.IsActive && hasRefinements){<span>Nothing matches your search within the journal filter (@Model.Filter.Summary).</span>}else if (Model.Filter.IsActive){<span>No trades fall within the journal filter (@Model.Filter.Summary). <a href="@($"{action}?period=all&side=all")">Clear the filter</a>.</span>}else{<span>Adjust the search or import a new record set.</span>}</div>
        }
        else
        {
            <div class="tf-table-wrap"><table class="table table-vcenter tf-table"><thead><tr><th class="tf-review-indicators-column"><span class="visually-hidden">Review indicators</span></th><th>Time</th><th>Instrument</th><th>Side</th><th class="tf-num">Qty</th><th class="tf-num">Entry</th><th class="tf-num">Exit</th><th class="tf-num">Points</th><th class="tf-num">Net P&amp;L</th><th class="tf-num">MAE / MFE</th><th>Status</th></tr></thead><tbody>
            @foreach (var trade in Model.Results.Items)
            {
                var date = Model.GetReviewDate(trade);
                var reviewDate = date.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
                var reviewUrl = $"/journal/{trade.JournalId:D}/review?date={reviewDate}&focus={Uri.EscapeDataString(trade.ReviewKey)}";
                <tr data-row-href="@reviewUrl"><td class="tf-review-indicators-cell"><span class="tf-ledger-indicators">
                    @if (Model.DailyJournalEntryDates.Contains(date))
                    {
                        <span class="tf-review-indicator tf-daily-journal-indicator" data-review-indicator="daily-journal" title="Daily journal entry" aria-label="Daily journal entry">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18M8 15h3M8 18h6"/></svg>
                        </span>
                    }
                    @await Html.PartialAsync("_ReviewIndicators", trade)
                </span></td><td class="text-nowrap"><a class="row-link" href="@reviewUrl">@EntryLabel(trade)</a></td><td><strong title="@trade.Symbol · @trade.Account">@trade.Instrument</strong></td><td><span class="tf-side @(trade.Direction.Equals("Short", StringComparison.OrdinalIgnoreCase) ? "tf-side-short" : "tf-side-long")">@trade.Direction</span></td><td class="tf-num">@trade.ClosedQuantity/@trade.Quantity</td><td class="tf-num">@trade.EntryPrice.ToString("0.########")</td><td class="tf-num">@(trade.ExitPrice?.ToString("0.########") ?? "—")</td><td class="tf-num @(trade.AveragePoints >= 0 ? "positive" : "negative")">@trade.AveragePoints.ToString("0.##")</td><td class="tf-num @(trade.NetPnl >= 0 ? "positive" : "negative")">@trade.NetPnl.ToString("C2")</td><td class="tf-num">@(trade.MaePoints?.ToString("0.##") ?? "—") / @(trade.MfePoints?.ToString("0.##") ?? "—")</td><td><span class="tf-status @(trade.Status.Equals("closed", StringComparison.OrdinalIgnoreCase) ? "tf-status-closed" : "tf-status-open")">@trade.Status</span></td></tr>
            }
            </tbody></table></div>
        }
    </div>
    @if (Model.Results.PageCount > 1)
    {
        <div class="card-footer"><ul class="pagination mb-0 justify-content-end tf-pagination">
            <li class="page-item @(Model.Results.Page <= 1 ? "disabled" : string.Empty)"><a class="page-link" href="@($"{action}?page={Model.Results.Page - 1}&search={Uri.EscapeDataString(Model.Search)}&symbol={Uri.EscapeDataString(Model.Symbol)}&status={Uri.EscapeDataString(Model.Status)}&sort={Uri.EscapeDataString(Model.Sort)}{filterSuffix}")">Previous</a></li>
            @for (var pageNumber = 1; pageNumber <= Model.Results.PageCount; pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.Results.Page ? "active" : string.Empty)"><a class="page-link" href="@($"{action}?page={pageNumber}&search={Uri.EscapeDataString(Model.Search)}&symbol={Uri.EscapeDataString(Model.Symbol)}&status={Uri.EscapeDataString(Model.Status)}&sort={Uri.EscapeDataString(Model.Sort)}{filterSuffix}")">@pageNumber</a></li>
            }
            <li class="page-item @(Model.Results.Page >= Model.Results.PageCount ? "disabled" : string.Empty)"><a class="page-link" href="@($"{action}?page={Model.Results.Page + 1}&search={Uri.EscapeDataString(Model.Search)}&symbol={Uri.EscapeDataString(Model.Symbol)}&status={Uri.EscapeDataString(Model.Status)}&sort={Uri.EscapeDataString(Model.Sort)}{filterSuffix}")">Next</a></li>
        </ul></div>
    }
</section>
