@page
@model TradeFoundry.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="card tf-card tf-auth-card">
    <div class="card-body p-4 p-md-5">
        <div class="tf-kicker">TRADEFOUNDRY / LOCAL INSTANCE</div>
        <h1>Welcome back.</h1>
        <p class="tf-lede mb-4">Unlock this journal on the device where it lives.</p>
        @if (!string.IsNullOrWhiteSpace(Model.FlashMessage)) { <div class="alert tf-alert">@Model.FlashMessage</div> }
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert tf-alert error">@Model.ErrorMessage</div> }
        <form method="post" class="row g-3">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="col-12"><label class="form-label" for="Password">Password</label><input asp-for="Password" class="form-control" type="password" autocomplete="current-password" required autofocus /></div>
            <div class="col-12"><button class="btn btn-primary" type="submit">Open TradeFoundry</button></div>
        </form>
        <p class="tf-helper mt-4 mb-0">No cloud account. No vendor journal subscription. This login is only for this installation.</p>
    </div>
</div>
