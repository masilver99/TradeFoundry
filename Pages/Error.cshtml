@page "/Error/{statusCode:int}"
@model ErrorModel
@{
    ViewData["Title"] = $"Error {Model.HttpStatusCode}";
    ViewData["PageKicker"] = "TRADEFOUNDRY / SYSTEM MESSAGE";
}

<section class="tf-error-page" aria-labelledby="error-title">
    <div class="tf-error-code">@Model.HttpStatusCode</div>
    <h1 id="error-title">Something went wrong.</h1>
    <p class="tf-error-message">The request could not be completed. Please return to the workspace and try again.</p>
    <a class="btn btn-primary" href="/">Return to TradeFoundry</a>

    @if (Model.ShowRequestId)
    {
        <p class="tf-error-request"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
</section>
