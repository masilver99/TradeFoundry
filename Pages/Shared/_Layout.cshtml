<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · TradeFoundry</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="header-inner">
            <a class="brand" asp-page="/Index"><span class="brand-glyph">TF</span><span>TradeFoundry</span></a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="header-actions"><span class="owner-label">@User.Identity.Name</span><form method="post" asp-page="/Login" asp-page-handler="Logout"><button class="button ghost" type="submit">Lock</button></form></div>
            }
        </div>
    </header>
    <main role="main">@RenderBody()</main>
    <footer class="site-footer"><span>TradeFoundry · local-first futures journaling</span><span>Phase 1 · imports are auditable</span></footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
