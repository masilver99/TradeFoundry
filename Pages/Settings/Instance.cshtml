@page "/journal/{journalId:guid}/settings/instance"
@model TradeFoundry.Pages.Settings.InstanceModel
@{
    ViewData["Title"] = "Instance settings";
    ViewData["PageKicker"] = "TRADEFOUNDRY / SETTINGS / INSTANCE";
    ViewData["ActiveNav"] = "settings";
    ViewData["SettingsSection"] = "instance";
}

@await Html.PartialAsync("_SettingsNav", Model.JournalId)

@if (!string.IsNullOrWhiteSpace(Model.FlashMessage))
{
    <div class="alert tf-alert @(Model.FlashKind == "error" ? "error" : string.Empty)" role="status">@Model.FlashMessage</div>
}

<div class="tf-settings-intro">
    <div>
        <div class="tf-kicker">LOCAL INSTANCE</div>
        <h3 class="tf-settings-heading">Storage and lifecycle</h3>
        <p class="text-secondary mb-0">Review where this local instance stores its data and remove inactive journals from the active selector.</p>
    </div>
</div>

<section class="row row-cards">
    <div class="col-xl-6">
        <div class="card tf-card">
            <div class="card-header"><div><div class="tf-kicker">LOCAL INSTANCE</div><h3 class="tf-card-title">Storage</h3></div></div>
            <div class="card-body">
                <dl class="tf-definition-list"><dt>Database size</dt><dd>@Model.DatabaseSize</dd><dt>Location</dt><dd class="text-break">@Model.DatabasePath</dd><dt>Active journals</dt><dd>@Model.Journals.Count</dd></dl>
            </div>
        </div>
    </div>
    @if (Model.Journals.Count > 1)
    {
        <div class="col-xl-6">
            <div class="card tf-card border-danger">
                <div class="card-header"><div><div class="tf-kicker text-danger">LIFECYCLE</div><h3 class="tf-card-title">Archive this journal</h3></div></div>
                <div class="card-body">
                    <p class="text-secondary small">Archived journals disappear from the active selector, but their data remains in the database.</p>
                    <form method="post" action="@($"/journal/{Model.JournalId:D}/settings/instance?handler=Archive")" onsubmit="return confirm('Archive this journal?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="journalId" value="@Model.JournalId" />
                        <button class="btn btn-outline-danger" type="submit">Archive @Model.Journal?.Name</button>
                    </form>
                </div>
            </div>
        </div>
    }
</section>
