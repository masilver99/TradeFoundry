@using TradeFoundry.Core
@using TradeFoundry.Data
@using TradeFoundry.Services
@inject TradeFoundryDb Database
@{
    var authenticated = User.Identity?.IsAuthenticated == true;
    var journals = authenticated ? Database.GetJournals() : Array.Empty<Journal>();
    var requestedJournal = Context.Request.RouteValues["journalId"]?.ToString() ?? Context.Request.Query["journalId"].ToString();
    Guid.TryParse(requestedJournal, out var requestedJournalId);
    var activeJournal = journals.FirstOrDefault(x => x.Id == requestedJournalId) ?? journals.FirstOrDefault();
    var activeNav = ViewData["ActiveNav"]?.ToString() ?? string.Empty;
    var pageTitle = ViewData["Title"]?.ToString() ?? "Workspace";
    var pageKicker = ViewData["PageKicker"]?.ToString() ?? "TRADEFOUNDRY / WORKSPACE";
    // The brand already sits in the sidebar, so the header breadcrumb drops the leading "TRADEFOUNDRY /".
    const string kickerBrandPrefix = "TRADEFOUNDRY / ";
    var pageSection = pageKicker.StartsWith(kickerBrandPrefix, StringComparison.OrdinalIgnoreCase) ? pageKicker[kickerBrandPrefix.Length..] : pageKicker;
    var usesPlotly = ViewData["UsesPlotly"] as bool? == true;
    var usesLightweightCharts = ViewData["UsesLightweightCharts"] as bool? == true;
    var usesLexical = ViewData["UsesLexical"] as bool? == true;
    var exportOwnerName = authenticated ? User.Identity?.Name ?? "Owner" : string.Empty;
    var exportJournalName = activeJournal?.Name ?? string.Empty;
    string JournalPath(string page) => activeJournal is null ? "/" : $"/journal/{activeJournal.Id:D}/{page}";
    var brandPath = activeJournal is null ? "/" : JournalPath("overview");
    // Pages that apply the journal filter register it for this request; other journal pages only get a note when one is remembered.
    var routeJournal = journals.FirstOrDefault(x => x.Id == requestedJournalId && Context.Request.RouteValues.ContainsKey("journalId"));
    var filterContext = authenticated ? JournalFilterRequest.Current(Context, routeJournal) : null;
}
<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle · TradeFoundry</title>
    <link rel="icon" type="image/webp" href="~/images/TradeFoundryLogo.webp" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/tabler/tabler.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(authenticated ? "tf-app" : "tf-public")" data-chart-export-owner-name="@exportOwnerName" data-chart-export-journal-name="@exportJournalName" data-notification-owner-name="@exportOwnerName" data-command-journal-id="@(activeJournal?.Id.ToString("D") ?? string.Empty)" data-command-search-url="@(activeJournal is null ? string.Empty : $"/journal/{activeJournal.Id:D}/command-search")">
@if (authenticated)
{
    @if (activeJournal is not null)
    {
        <dialog class="tf-command-dialog" id="tf-command-dialog" aria-labelledby="tf-command-title" aria-describedby="tf-command-help" data-command-dialog>
            <div class="tf-command-heading">
                <h2 id="tf-command-title">Search TradeFoundry</h2>
                <button type="button" class="tf-command-close" data-command-close aria-label="Close search">×</button>
            </div>
            <label class="visually-hidden" for="tf-command-input">Search pages, charts, metrics, trades, and notes</label>
            <div class="tf-command-input-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg>
                <input id="tf-command-input" type="search" class="tf-command-input" placeholder="Search pages, charts, metrics, trades, and notes…" autocomplete="off" spellcheck="false" role="combobox" aria-autocomplete="list" aria-expanded="true" aria-controls="tf-command-results" data-command-input />
            </div>
            <div id="tf-command-results" class="tf-command-results" role="listbox" aria-label="Search results" data-command-results></div>
            <div class="tf-command-status" role="status" aria-live="polite" data-command-status></div>
            <div class="tf-command-footer" id="tf-command-help"><span><kbd>↑</kbd><kbd>↓</kbd> Navigate</span><span><kbd>Enter</kbd> Open</span><span><kbd>Esc</kbd> Close</span></div>
        </dialog>
<script id="tf-command-catalog" type="application/json">@Html.Raw(CommandPaletteCatalog.ToJson())</script>
    }
    <div class="page">
        <aside id="workspace-sidebar" class="navbar navbar-vertical navbar-expand-lg tf-sidebar" data-bs-theme="dark">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#workspace-sidebar-menu" aria-controls="workspace-sidebar-menu" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="tf-sidebar-brand-row">
                    <h1 class="navbar-brand navbar-brand-autodark tf-brand">
                        <a href="@brandPath"><img class="tf-brand-logo" src="~/images/TradeFoundryLogo.webp" alt="TradeFoundry" asp-append-version="true" /></a>
                    </h1>
                    <button type="button" class="tf-sidebar-toggle" data-sidebar-toggle aria-controls="workspace-sidebar" aria-expanded="true" aria-label="Hide sidebar" title="Hide sidebar">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
                    </button>
                </div>
                <div class="tf-journal-context">
                    <div class="tf-journal-context-heading">
                        <div class="tf-sidebar-label">ACTIVE JOURNAL</div>
                        <div class="tf-notification-host" data-notification-host>
                            <button type="button" class="tf-notification-toggle" data-notification-toggle aria-controls="tf-notification-panel" aria-expanded="false" aria-label="Notifications" title="Notifications">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/><path d="M10 21h4"/></svg>
                                <span class="tf-notification-badge" data-notification-count aria-hidden="true" hidden></span>
                            </button>
                            <section id="tf-notification-panel" class="tf-notification-panel" data-notification-panel aria-label="Notifications" hidden>
                                <div class="tf-notification-panel-header"><h2>Notifications</h2><span data-notification-summary aria-live="polite"></span></div>
                                <div class="tf-notification-list" data-notification-list role="list"></div>
                                <p class="tf-notification-empty" data-notification-empty hidden>No notifications.</p>
                            </section>
                        </div>
                    </div>
                    @if (journals.Count > 0)
                    {
                        <select id="journal-select" class="form-select form-select-sm" aria-label="Active journal" onchange="if (this.value) window.location.href = this.value">
                            @foreach (var journal in journals)
                            {
                                <option value="@($"/journal/{journal.Id:D}/overview")" selected="@(activeJournal?.Id == journal.Id)">@journal.Name</option>
                            }
                        </select>
                        <div class="tf-context-meta">@activeJournal?.ExecutionContext · @activeJournal?.Currency</div>
                    }
                    else
                    {
                        <span class="text-secondary small">Create your first journal in Settings.</span>
                    }
                </div>
                <div class="collapse navbar-collapse" id="workspace-sidebar-menu">
                    <ul class="navbar-nav pt-lg-3">
                        <li class="nav-item tf-nav-heading">TRADE</li>
                        <li class="nav-item"><a class="nav-link @(activeNav == "overview" ? "active" : string.Empty)" href="@JournalPath("overview")"><svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13h4v7H4z"/><path d="M10 4h4v16h-4z"/><path d="M16 9h4v11h-4z"/></svg><span class="nav-link-title">Overview</span></a></li>
                        <li class="nav-item"><a class="nav-link @(activeNav == "daily-journal" ? "active" : string.Empty)" href="@JournalPath("daily-journal")"><svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h14v16H5z"/><path d="M8 8h8M8 12h8M8 16h5"/><path d="M3 6v14"/></svg><span class="nav-link-title">Daily Journal</span></a></li>
                        <li class="nav-item"><a class="nav-link @(activeNav == "review" ? "active" : string.Empty)" href="@JournalPath("review")"><svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg><span class="nav-link-title">Trade Review</span></a></li>
                        <li class="nav-item"><a class="nav-link @(activeNav == "trades" ? "active" : string.Empty)" href="@JournalPath("trades")"><svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19l4-4 3 3 6-7 3 3"/><path d="M15 8h5v5"/></svg><span class="nav-link-title">Trade Ledger</span></a></li>
                        <li class="nav-item"><a class="nav-link @(activeNav == "setups" ? "active" : string.Empty)" href="@JournalPath("setups")"><svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h10"/><path d="m17 15 2 2 4-4"/></svg><span class="nav-link-title">Setups</span></a></li>
                        <li class="nav-item tf-nav-heading mt-4">ANALYZE</li>
                        <li class="nav-item"><a class="nav-link @(activeNav == "analysis" ? "active" : string.Empty)" href="@JournalPath("analytics")"><svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 16v-4"/><path d="M12 16V8"/><path d="M17 16v-7"/></svg><span class="nav-link-title">Analytics</span></a></li>
                        <li class="nav-item"><a class="nav-link @(activeNav == "indicators" ? "active" : string.Empty)" href="@JournalPath("indicators")"><svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V5"/><path d="M4 15h5l2-7 3 11 2-6h4"/></svg><span class="nav-link-title">Indicators</span></a></li>
                        <li class="nav-item"><a class="nav-link @(activeNav == "market-regime" ? "active" : string.Empty)" href="@JournalPath("market-regime")"><svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V5"/><path d="M4 19h16"/><path d="m7 15 4-4 3 2 5-6"/><path d="M17 7h2v2"/></svg><span class="nav-link-title">Market Regime</span></a></li>
                        <li class="nav-item tf-nav-heading mt-4">MONEY</li>
                        <li class="nav-item"><a class="nav-link @(activeNav == "account" ? "active" : string.Empty)" href="@JournalPath("account")"><svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/><path d="M7 15h3"/></svg><span class="nav-link-title">Account</span></a></li>
                        <li class="nav-item"><a class="nav-link @(activeNav == "expenses" ? "active" : string.Empty)" href="@JournalPath("expenses")"><svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2zM9 7h6M9 11h6M9 15h3"/></svg><span class="nav-link-title">Expenses</span></a></li>
                        <li class="nav-item"><a class="nav-link @(activeNav == "tax-liability" ? "active" : string.Empty)" href="@JournalPath("tax-liability")"><svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7.5" cy="7.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/><path d="M19 5 5 19"/></svg><span class="nav-link-title">Tax Liability</span></a></li>
                        <li class="nav-item"><a class="nav-link @(activeNav == "broker-comparison" ? "active" : string.Empty)" href="@JournalPath("broker-comparison")"><svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19h16"/><path d="M6 16V9M12 16V5M18 16v-3"/><path d="M4 19l4-4 4 2 6-7"/></svg><span class="nav-link-title">Broker Costs</span></a></li>
                        <li class="nav-item tf-nav-heading mt-4">DATA</li>
                        <li class="nav-item"><a class="nav-link @(activeNav == "imports" ? "active" : string.Empty)" href="@JournalPath("imports")"><svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="M8 11l4 4 4-4"/><path d="M5 21h14"/><path d="M5 18h14"/></svg><span class="nav-link-title">Imports</span></a></li>
                        <li class="nav-item"><a class="nav-link @(activeNav == "publishing" ? "active" : string.Empty)" href="@JournalPath("publishing")"><svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18z"/></svg><span class="nav-link-title">Publishing</span></a></li>
                        <li class="nav-item"><a class="nav-link @(activeNav == "settings" ? "active" : string.Empty)" href="@JournalPath("settings")"><svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-1.8 1.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-2.6V20a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1-1.8-1.8.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.6-1H6v-2.6h.2a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1 1.8-1.8.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1.9-.3l.1-.1 1.8 1.8-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v2.6H21a1.7 1.7 0 0 0-1.6 1z"/></svg><span class="nav-link-title">Settings</span></a></li>
                    </ul>
                    <div class="mt-auto tf-sidebar-footer">
                        <div class="tf-owner-row"><span class="avatar avatar-sm bg-yellow-lt">@((User.Identity?.Name ?? "Owner").FirstOrDefault())</span><div><strong>@User.Identity?.Name</strong><span>Local owner</span></div></div>
                        <form method="post" action="/Login?handler=Logout">@Html.AntiForgeryToken()<button type="submit" class="btn btn-ghost-secondary w-100">Lock workspace</button></form>
                        <button type="button" class="tf-sidebar-toggle tf-sidebar-toggle-bottom" data-sidebar-toggle aria-controls="workspace-sidebar" aria-expanded="true" aria-label="Hide sidebar" title="Hide sidebar">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
                        </button>
                    </div>
                </div>
                <div class="tf-sidebar-resizer" data-sidebar-resizer role="separator" aria-label="Resize sidebar" aria-orientation="vertical" aria-valuemin="180" aria-valuemax="360" aria-valuenow="220" tabindex="0"></div>
            </div>
        </aside>
        <button type="button" class="tf-sidebar-reopen" data-sidebar-toggle aria-controls="workspace-sidebar" aria-expanded="false" aria-label="Show sidebar" title="Show sidebar" hidden>
            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </button>
        <div class="page-wrapper">
            @if (activeNav != "review")
            {
            <div class="page-header d-print-none">
                <div class="container-xl">
                    <div class="row align-items-center">
                        <div class="col tf-page-heading"><h2 class="page-title">@pageTitle</h2><div class="page-pretitle">@pageSection</div></div>
                        @if (activeJournal is not null)
                        {
                            <div class="col-auto tf-page-header-tools">
                                <button type="button" class="tf-command-trigger" data-command-trigger aria-haspopup="dialog" aria-controls="tf-command-dialog" aria-expanded="false" title="Search TradeFoundry (Ctrl+K)">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg>
                                    <span>Search</span><kbd data-command-shortcut>Ctrl K</kbd>
                                </button>
                                <span class="tf-page-context" title="@activeJournal.TimeZone">@activeJournal.Name <span>·</span> @TimeZoneCatalog.DisplayName(activeJournal.TimeZone)</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
            }
            <div class="page-body"><div class="container-xl">@if (filterContext is not null){<partial name="_JournalFilterBar" model="filterContext" />}@RenderBody()</div></div>
        </div>
    </div>
}
else
{
    <div class="tf-public-frame"><header class="tf-public-header"><a class="tf-public-brand" href="/"><img class="tf-brand-logo" src="~/images/TradeFoundryLogo.webp" alt="TradeFoundry" asp-append-version="true" /></a></header><main class="tf-public-main">@RenderBody()</main><footer class="tf-public-footer">Local-first futures journaling · no cloud account required</footer></div>
}
<script src="~/lib/tabler/tabler.min.js" asp-append-version="true"></script>
@if (usesPlotly)
{
    <script src="~/lib/plotly/plotly.min.js" asp-append-version="true"></script>
}
@if (usesLightweightCharts)
{
    <script src="~/lib/lightweight-charts/lightweight-charts.standalone.production.js" asp-append-version="true"></script>
    <script src="~/publication-assets/trade-execution-drawing.js"></script>
}
@if (usesLexical)
{
    <script src="~/js/lexical-editor.bundle.js" asp-append-version="true"></script>
}
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/command-palette.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
