@page "/journal/{journalId:guid}/settings/access"
@model TradeFoundry.Pages.Settings.AccessModel
@{
    ViewData["Title"] = "Access settings";
    ViewData["PageKicker"] = "TRADEFOUNDRY / SETTINGS / ACCESS";
    ViewData["ActiveNav"] = "settings";
    ViewData["SettingsSection"] = "access";
}

@await Html.PartialAsync("_SettingsNav", Model.JournalId)

@if (!string.IsNullOrWhiteSpace(Model.FlashMessage))
{
    <div class="alert tf-alert @(Model.FlashKind == "error" ? "error" : string.Empty)" role="status">@Model.FlashMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.NewMcpToken))
{
    <div class="alert tf-alert warning" role="alert">Copy this token now. It will not be shown again: <code>@Model.NewMcpToken</code></div>
}

<div class="tf-settings-intro">
    <div>
        <div class="tf-kicker">LOCAL ACCESS</div>
        <h3 class="tf-settings-heading">Password and AI connections</h3>
        <p class="text-secondary mb-0">TradeFoundry is local-first. Keep owner access and scoped MCP access separate.</p>
    </div>
</div>

<section class="row row-cards">
    <div class="col-xl-5">
        <div class="card tf-card">
            <div class="card-header"><div><div class="tf-kicker">LOCAL INSTANCE</div><h3 class="tf-card-title">Change password</h3></div></div>
            <div class="card-body">
                <p class="text-secondary small">Use an empty new password if you prefer passwordless access on this local instance.</p>
                <form method="post" action="@($"/journal/{Model.JournalId:D}/settings/access?handler=ChangePassword")" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="journalId" value="@Model.JournalId" />
                    <div class="col-12"><label class="form-label">Current password<input class="form-control" name="CurrentPassword" type="password" autocomplete="current-password" /></label></div>
                    <div class="col-12"><label class="form-label">New password<input class="form-control" name="NewPassword" type="password" autocomplete="new-password" /></label></div>
                    <div class="col-12"><label class="form-label">Confirm new password<input class="form-control" name="ConfirmNewPassword" type="password" autocomplete="new-password" /></label></div>
                    <div class="col-12"><button class="btn btn-outline-primary" type="submit">Change password</button></div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-xl-7">
        <div class="card tf-card">
            <div class="card-header"><div><div class="tf-kicker">LOCAL AI ACCESS</div><h3 class="tf-card-title">MCP server</h3></div><span class="badge @(Model.McpEnabled ? "bg-green-lt" : "bg-secondary-lt")">@(Model.McpEnabled ? "enabled" : "disabled")</span></div>
            <div class="card-body">
                <p class="text-secondary small">Tokens can see only the journals selected below. Read-only tokens cannot write; optional write scope is limited to user-managed broker fee profiles. Imported journal evidence is never changed.</p>
                <dl class="tf-definition-list"><dt>Endpoint</dt><dd class="text-break"><code>@Model.McpEndpoint</code></dd><dt>Transport</dt><dd>Stateless Streamable HTTP · loopback only</dd></dl>
                @if (!Model.McpEnabled)
                {
                    <div class="alert tf-alert mb-3">Set <code>Mcp:Enabled</code> to <code>true</code> and restart TradeFoundry before connecting an AI client.</div>
                }
                <form method="post" action="@($"/journal/{Model.JournalId:D}/settings/access?handler=CreateMcpToken")" class="row g-3 mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="journalId" value="@Model.JournalId" />
                    <div class="col-12"><label class="form-label">Client name<input asp-for="McpTokenName" class="form-control" maxlength="100" required /></label></div>
                    <div class="col-12">
                        <div class="form-label">Allowed journals</div>
                        @foreach (var journal in Model.Journals)
                        {
                            <label class="form-check mb-1"><input class="form-check-input" type="checkbox" name="McpJournalIds" value="@journal.Id" checked="@(journal.Id == Model.JournalId ? "checked" : null)" /><span class="form-check-label">@journal.Name <span class="text-secondary">(@journal.ExecutionContext)</span></span></label>
                        }
                    </div>
                    <div class="col-12">
                        <label class="form-check"><input asp-for="McpAllowFeeProfileWrites" class="form-check-input" /><span class="form-check-label">Allow broker fee profile writes</span></label>
                        <div class="form-hint">Allows this token to create and edit comparison profiles through MCP. It still cannot change imported trades or other journal evidence.</div>
                    </div>
                    <div class="col-12"><button class="btn btn-outline-primary" type="submit">Generate scoped token</button></div>
                </form>
                @if (Model.McpTokens.Count > 0)
                {
                    <div class="tf-kicker mb-2">ISSUED TOKENS</div>
                    @foreach (var token in Model.McpTokens)
                    {
                        <div class="border-top py-2">
                            <div class="d-flex justify-content-between gap-2"><div><strong>@token.Name</strong><div class="small text-secondary"><code>@token.TokenPrefix…</code> · @token.Scopes · @token.JournalIds.Count journal(s) · created @token.CreatedUtc.ToString("yyyy-MM-dd")</div>@if (token.LastUsedUtc.HasValue){<div class="small text-secondary">Last used @token.LastUsedUtc.Value.ToString("yyyy-MM-dd HH:mm 'UTC'")</div>}</div>@if (token.IsRevoked){<span class="badge bg-secondary-lt align-self-start">revoked</span>}else{<form method="post" action="@($"/journal/{Model.JournalId:D}/settings/access?handler=RevokeMcpToken")" onsubmit="return confirm('Revoke this MCP token?');">@Html.AntiForgeryToken()<input type="hidden" name="journalId" value="@Model.JournalId" /><input type="hidden" name="tokenId" value="@token.Id" /><button class="btn btn-sm btn-outline-danger" type="submit">Revoke</button></form>}</div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>
