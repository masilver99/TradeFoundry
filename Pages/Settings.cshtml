@page "/journal/{journalId:guid}/settings"
@model TradeFoundry.Pages.SettingsModel
@{
    ViewData["Title"] = "Settings";
    ViewData["PageKicker"] = "TRADEFOUNDRY / INSTANCE";
    ViewData["ActiveNav"] = "settings";
}

@await Html.PartialAsync("_SettingsNav", Model.JournalId)

<div class="tf-settings-intro">
    <div>
        <div class="tf-kicker">CONFIGURATION</div>
        <h3 class="tf-settings-heading">Configure @Model.Journal!.Name</h3>
        <p class="text-secondary mb-0">Settings are grouped by concern so this area can grow without turning into one long form.</p>
    </div>
</div>

<section class="row row-cards">
    <div class="col-md-6 col-xl-4">
        <a class="card tf-card tf-settings-card" href="@($"/journal/{Model.JournalId:D}/settings/journal")">
            <div class="card-body">
                <div class="tf-settings-card-icon">✦</div>
                <h3 class="tf-card-title">Journal</h3>
                <p class="text-secondary">Name, Markdown description, execution context, labels, timezone, currency, and trade grouping.</p>
                <span class="tf-settings-card-link">Open journal settings →</span>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-xl-4">
        <a class="card tf-card tf-settings-card" href="@($"/journal/{Model.JournalId:D}/settings/instruments")">
            <div class="card-body">
                <div class="tf-settings-card-icon">◎</div>
                <h3 class="tf-card-title">Instruments</h3>
                <p class="text-secondary">Define point values, tick sizes, and default commissions used during normalization.</p>
                <span class="tf-settings-card-link">Open instrument settings →</span>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-xl-4">
        <a class="card tf-card tf-settings-card" href="@($"/journal/{Model.JournalId:D}/settings/sources")">
            <div class="card-body">
                <div class="tf-settings-card-icon">⌁</div>
                <h3 class="tf-card-title">Import sources</h3>
                <p class="text-secondary">Map source symbols to configured instruments and control import-specific overrides.</p>
                <span class="tf-settings-card-link">Open source settings →</span>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-xl-4">
        <a class="card tf-card tf-settings-card" href="@($"/journal/{Model.JournalId:D}/settings/workspace")">
            <div class="card-body">
                <div class="tf-settings-card-icon">⌂</div>
                <h3 class="tf-card-title">Workspace</h3>
                <p class="text-secondary">Create and manage the local journals available in this TradeFoundry workspace.</p>
                <span class="tf-settings-card-link">Open workspace settings →</span>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-xl-4">
        <a class="card tf-card tf-settings-card" href="@($"/journal/{Model.JournalId:D}/settings/access")">
            <div class="card-body">
                <div class="tf-settings-card-icon">⌑</div>
                <h3 class="tf-card-title">Access</h3>
                <p class="text-secondary">Change the local owner password and manage read-only MCP connections.</p>
                <span class="tf-settings-card-link">Open access settings →</span>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-xl-4">
        <a class="card tf-card tf-settings-card" href="@($"/journal/{Model.JournalId:D}/settings/instance")">
            <div class="card-body">
                <div class="tf-settings-card-icon">◌</div>
                <h3 class="tf-card-title">Instance</h3>
                <p class="text-secondary">Review local storage details and archive the current journal when it is no longer active.</p>
                <span class="tf-settings-card-link">Open instance settings →</span>
            </div>
        </a>
    </div>
</section>
