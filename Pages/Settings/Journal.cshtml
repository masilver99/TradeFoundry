@page "/journal/{journalId:guid}/settings/journal"
@model TradeFoundry.Pages.Settings.JournalModel
@{
    ViewData["Title"] = "Journal settings";
    ViewData["PageKicker"] = "TRADEFOUNDRY / SETTINGS / JOURNAL";
    ViewData["ActiveNav"] = "settings";
    ViewData["SettingsSection"] = "journal";
    ViewData["UsesLexical"] = true;
}

@await Html.PartialAsync("_SettingsNav", Model.JournalId)

@if (!string.IsNullOrWhiteSpace(Model.FlashMessage))
{
    <div class="alert tf-alert @(Model.FlashKind == "error" ? "error" : string.Empty)" role="status">@Model.FlashMessage</div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert tf-alert error" role="alert">@Html.ValidationSummary(excludePropertyErrors: false)</div>
}

<div class="tf-settings-intro">
    <div>
        <div class="tf-kicker">ACTIVE JOURNAL</div>
        <h3 class="tf-settings-heading">Journal identity and defaults</h3>
        <p class="text-secondary mb-0">Describe what this journal is for and set the defaults used by its analysis and imports.</p>
    </div>
</div>

<div class="card tf-card">
    <div class="card-body">
        <form method="post" action="@($"/journal/{Model.JournalId:D}/settings/journal?handler=Save")" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="JournalId" />
            <div class="col-md-8">
                <label class="form-label" asp-for="Name">Name</label>
                <input asp-for="Name" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label" asp-for="ExecutionContext">Execution context</label>
                <select asp-for="ExecutionContext" class="form-select">
                    <option value="live">Live</option>
                    <option value="paper">Paper</option>
                    <option value="replay">Replay</option>
                    <option value="backtest">Backtest</option>
                    <option value="other">Other</option>
                </select>
            </div>
            <div class="col-12">
                <label id="journal-description-label" class="form-label" asp-for="DescriptionLexicalStateJson">Description</label>
                <div class="tf-lexical-editor" data-lexical-editor data-max-length="100000" hidden>
                    <div class="tf-lexical-toolbar" role="toolbar" aria-label="Journal description formatting">
                        <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="bold" title="Bold" aria-label="Bold"><strong>B</strong></button>
                        <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="italic" title="Italic" aria-label="Italic"><em>I</em></button>
                        <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="heading" title="Heading" aria-label="Heading">H</button>
                        <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="link" title="Link" aria-label="Link">↗</button>
                        <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="unordered-list" title="Bullet list" aria-label="Bullet list">•</button>
                        <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="ordered-list" title="Numbered list" aria-label="Numbered list">1.</button>
                        <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="quote" title="Quote" aria-label="Quote">❯</button>
                        <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="code" title="Inline code" aria-label="Inline code">&lt;/&gt;</button>
                        <span class="tf-lexical-toolbar-spacer"></span>
                        <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="undo" title="Undo" aria-label="Undo">↶</button>
                        <button type="button" class="btn btn-sm btn-ghost-secondary" data-lexical-action="redo" title="Redo" aria-label="Redo">↷</button>
                    </div>
                    <div class="tf-lexical-root" data-lexical-root contenteditable="true" role="textbox" aria-multiline="true" aria-labelledby="journal-description-label" data-placeholder="What is this journal for? Add setup notes, rules, or context."></div>
                    <small class="tf-lexical-limit-status" data-lexical-limit-status aria-live="polite"></small>
                </div>
                <textarea asp-for="DescriptionLexicalStateJson" class="form-control tf-lexical-source" rows="14" maxlength="100000" data-lexical-source hidden placeholder="Describe what this journal is for."></textarea>
                <div class="form-hint">Use the toolbar or Markdown shortcuts such as **bold**, # heading, and - list. Rich text is stored with the journal.</div>
                <span asp-validation-for="DescriptionLexicalStateJson" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="Labels">Labels</label>
                <input asp-for="Labels" class="form-control" placeholder="algo, ORB, experimental" />
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="TimeZone">Timezone</label>
                <input asp-for="TimeZone" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="Currency">Currency</label>
                <input asp-for="Currency" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="StartingEquity">Starting equity <span class="text-secondary">(optional)</span></label>
                <input asp-for="StartingEquity" class="form-control" type="number" step="0.01" min="0" placeholder="Auto from balance" />
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="GroupingPolicy">Grouping policy</label>
                <select asp-for="GroupingPolicy" class="form-select">
                    <option value="flat_to_flat">Flat-to-flat</option>
                    <option value="fifo_lots">FIFO lots (phase 2)</option>
                    <option value="source_defined">Source-defined rows</option>
                </select>
            </div>
            <div class="col-12"><button class="btn btn-primary" type="submit">Save journal settings</button></div>
        </form>
    </div>
</div>

<div class="card tf-card mt-3">
    <div class="card-header">
        <div>
            <div class="tf-kicker">TRADE REVIEW</div>
            <h3 class="tf-card-title">MAE target</h3>
        </div>
    </div>
    <div class="card-body">
        <p class="text-secondary">Set a review target per contract. TradeFoundry flags recorded MAE at or above the target for review; this setting does not place or change broker orders.</p>
        <form method="post" action="@($"/journal/{Model.JournalId:D}/settings/journal?handler=SaveMaeTargets")" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="JournalId" />
            <div class="col-md-5">
                <label class="form-label" asp-for="MaeTargetPerContract">Default target per contract (@Model.Journal!.Currency)</label>
                <input asp-for="MaeTargetPerContract" class="form-control" type="number" min="0.01" step="0.01" placeholder="No default target" />
                <span asp-validation-for="MaeTargetPerContract" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label class="form-label" asp-for="MaeInstrumentOverrides">Instrument overrides</label>
                <textarea asp-for="MaeInstrumentOverrides" class="form-control" rows="4" spellcheck="false" placeholder="MES=35.00&#10;MNQ=50.00"></textarea>
                <div class="form-hint">One instrument root and amount per line. For example, MES=35.00. An override replaces the default for that instrument.</div>
                <span asp-validation-for="MaeInstrumentOverrides" class="text-danger"></span>
            </div>
            <div class="col-12"><button class="btn btn-primary" type="submit">Save MAE targets</button></div>
        </form>
    </div>
</div>
