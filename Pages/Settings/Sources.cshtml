@page "/journal/{journalId:guid}/settings/sources"
@model TradeFoundry.Pages.Settings.SourcesModel
@{
    ViewData["Title"] = "Import source settings";
    ViewData["PageKicker"] = "TRADEFOUNDRY / SETTINGS / IMPORT SOURCES";
    ViewData["ActiveNav"] = "settings";
    ViewData["SettingsSection"] = "sources";
}

@await Html.PartialAsync("_SettingsNav", Model.JournalId)

@if (!string.IsNullOrWhiteSpace(Model.FlashMessage))
{
    <div class="alert tf-alert @(Model.FlashKind == "error" ? "error" : string.Empty)" role="status">@Model.FlashMessage</div>
}

<div class="tf-settings-intro">
    <div>
        <div class="tf-kicker">IMPORT APPLICATION</div>
        <h3 class="tf-settings-heading">Source mappings</h3>
        <p class="text-secondary mb-0">Mappings connect imported source symbols to instrument definitions. They are checked from top to bottom.</p>
    </div>
</div>

<div class="card tf-card mb-3">
    <div class="card-header"><div><div class="tf-kicker">AUTOMATIC IMPORTS</div><h3 class="tf-card-title">Watched folder</h3></div></div>
    <div class="card-body">
        <form method="post" action="@($"/journal/{Model.JournalId:D}/settings/sources?handler=SaveImportWatchDirectory")" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="journalId" value="@Model.JournalId" />
            <div class="col-lg-9">
                <label asp-for="ImportWatchDirectory" class="form-label">Folder path on the TradeFoundry server</label>
                <input asp-for="ImportWatchDirectory" class="form-control font-monospace" placeholder="C:\\TradeFoundry\\Incoming" autocomplete="off" />
                <div class="form-hint">Leave blank to disable. CSV, TSV, and TXT files in this folder are scanned on startup and while the server runs. Supported trade exports are imported into this journal; files stay in the folder.</div>
            </div>
            <div class="col-lg-3 d-flex gap-2">
                <button class="btn btn-primary" type="submit">Save folder</button>
                @if (!string.IsNullOrWhiteSpace(Model.ImportWatchDirectory))
                {
                    <button class="btn btn-outline-secondary" type="submit" name="clearImportWatchDirectory" value="true">Disable</button>
                }
            </div>
        </form>
        @if (Model.WatchedImportFiles.Count > 0)
        {
            <div class="table-responsive mt-4">
                <table class="table table-vcenter tf-table">
                    <thead><tr><th>File</th><th>Last result</th><th>Updated (UTC)</th><th>Batch</th></tr></thead>
                    <tbody>
                    @foreach (var file in Model.WatchedImportFiles)
                    {
                        <tr>
                            <td class="font-monospace small">@System.IO.Path.GetFileName(file.FilePath)<small>@file.FilePath</small></td>
                            <td><span class="tf-status @(file.Status == "completed" ? "tf-status-closed" : "tf-status-open text-danger")">@file.Status</span>@if (!string.IsNullOrWhiteSpace(file.Message)){<small>@file.Message</small>}</td>
                            <td>@file.UpdatedUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@if (file.ImportBatchId.HasValue){<a href="/journal/@Model.JournalId/imports">View imports</a>}else{<span class="text-secondary">—</span>}</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card tf-card">
    <div class="card-header"><div><div class="tf-kicker">SIERRA CHART</div><h3 class="tf-card-title">Symbol mappings</h3></div><span class="badge bg-blue-lt">sierra_chart</span></div>
    <div class="card-body">
        <p class="text-secondary small">A commission override is per contract and takes precedence over the instrument default.</p>
        <div class="table-responsive">
            <table class="table table-vcenter tf-table">
                <thead><tr><th>Match regex</th><th>Instrument</th><th>Commission override / contract</th><th></th></tr></thead>
                <tbody>
                @foreach (var mapping in Model.SierraChartMappings)
                {
                    <tr>
                        <td colspan="4">
                            <form method="post" action="@($"/journal/{Model.JournalId:D}/settings/sources?handler=SaveSierraMapping")" class="row g-2 align-items-end">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="journalId" value="@Model.JournalId" />
                                <input type="hidden" name="mappingId" value="@mapping.Id" />
                                <input type="hidden" name="position" value="@mapping.Position" />
                                <div class="col-md-5"><label class="form-label">Regex<input class="form-control form-control-sm font-monospace" name="matchRegex" value="@mapping.MatchRegex" required maxlength="512" /></label></div>
                                <div class="col-md-3"><label class="form-label">Instrument<select class="form-select form-select-sm" name="instrumentCode" required>@foreach (var instrument in Model.Instruments){<option value="@instrument.Code" selected="@(instrument.Code.Equals(mapping.InstrumentCode, StringComparison.OrdinalIgnoreCase))">@instrument.Code</option>}</select></label></div>
                                <div class="col-md-3"><label class="form-label">Override<input class="form-control form-control-sm" name="commissionOverride" type="number" step="0.01" min="0" value="@(mapping.CommissionOverride?.ToString("0.########", System.Globalization.CultureInfo.InvariantCulture))" placeholder="Use instrument default" /></label></div>
                                <div class="col-md-1 d-flex gap-2"><button class="btn btn-sm btn-primary" type="submit">Save</button><button class="btn btn-sm btn-outline-danger" type="submit" formaction="@($"/journal/{Model.JournalId:D}/settings/sources?handler=DeleteSierraMapping")" formmethod="post" name="mappingId" value="@mapping.Id" onclick="return confirm('Remove this mapping?');">×</button></div>
                            </form>
                        </td>
                    </tr>
                }
                <tr>
                    <td colspan="4">
                        <div class="tf-kicker mb-2">ADD MAPPING</div>
                        @if (Model.Instruments.Count == 0)
                        {
                            <p class="text-secondary small mb-0">Add an instrument before creating a source mapping.</p>
                        }
                        else
                        {
                            <form method="post" action="@($"/journal/{Model.JournalId:D}/settings/sources?handler=SaveSierraMapping")" class="row g-2 align-items-end">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="journalId" value="@Model.JournalId" />
                                <input type="hidden" name="position" value="@Model.SierraChartMappings.Count" />
                                <div class="col-md-5"><label class="form-label">Regex<input class="form-control form-control-sm font-monospace" name="matchRegex" placeholder="e.g. (?&lt;!\w)MES" required maxlength="512" /></label></div>
                                <div class="col-md-3"><label class="form-label">Instrument<select class="form-select form-select-sm" name="instrumentCode" required>@foreach (var instrument in Model.Instruments){<option value="@instrument.Code">@instrument.Code</option>}</select></label></div>
                                <div class="col-md-3"><label class="form-label">Override<input class="form-control form-control-sm" name="commissionOverride" type="number" step="0.01" min="0" placeholder="Optional" /></label></div>
                                <div class="col-md-1"><button class="btn btn-sm btn-outline-primary" type="submit">Add</button></div>
                            </form>
                        }
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
