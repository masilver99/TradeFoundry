@page "/journal/{journalId:guid}/setups"
@model TradeFoundry.Pages.SetupsModel
@using System.Globalization
@using TradeFoundry.Core
@{
    ViewData["Title"] = "Trading setups";
    ViewData["PageKicker"] = "TRADEFOUNDRY / JOURNAL / SETUPS";
    ViewData["ActiveNav"] = "setups";
    string TypeLabel(SetupCriterionType type) => type switch
    {
        SetupCriterionType.Required => "Required",
        SetupCriterionType.Supporting => "Supporting",
        SetupCriterionType.Disqualifier => "Disqualifier",
        _ => "Context"
    };
    string StageLabel(SetupCriterionStage stage) => stage switch
    {
        SetupCriterionStage.Context => "Context",
        SetupCriterionStage.Setup => "Setup",
        SetupCriterionStage.Trigger => "Trigger",
        SetupCriterionStage.Management => "Management",
        _ => "Exit"
    };
    string Number(decimal? value, string format = "0.##") => value?.ToString(format, CultureInfo.CurrentCulture) ?? "—";
    string TradeLabel(int count) => $"{count} trade{(count == 1 ? string.Empty : "s")}";
}

<link rel="stylesheet" href="~/css/setups.css" asp-append-version="true" />
<template data-setup-stage-icons>
    @foreach (var stage in Enum.GetValues<SetupCriterionStage>())
    {
        <span data-stage-icon="@stage"><partial name="_SetupStageIcon" model="stage" /></span>
    }
</template>
@if (!string.IsNullOrWhiteSpace(Model.FlashMessage) && Model.OpenEditor is null)
{
    <div class="alert tf-alert @(Model.FlashKind == "error" ? "error" : string.Empty)" role="status">@Model.FlashMessage</div>
}
<div class="tf-settings-intro tf-setup-page-intro">
    <div><div class="tf-kicker">REUSABLE TRADE DEFINITIONS</div><h3 class="tf-settings-heading">Trading setups</h3>
    <p class="text-secondary mb-0">Define entry conditions, keep their versions intact, and evaluate them separately from execution and outcome.</p></div>
    <button class="btn btn-primary" type="button" data-setup-open="create" aria-haspopup="dialog" aria-controls="setup-editor">New setup</button>
</div>
<section class="card tf-card tf-setup-list-card">
    <div class="card-header"><div><div class="tf-kicker">MASTER LIST</div><h3 class="tf-card-title">Setups</h3></div><span class="text-secondary">@Model.Setups.Count</span></div>
    @if (Model.Setups.Count == 0)
    {
        <div class="card-body text-secondary">Choose New setup to create your first reusable definition.</div>
    }
    else
    {
        <div class="table-responsive"><table class="table table-vcenter tf-table tf-setup-list-table">
            <caption class="visually-hidden">Trading setups. Select a setup to open its details.</caption>
            <thead><tr><th scope="col">Setup</th><th scope="col">Category</th><th scope="col">Version</th><th scope="col" class="text-end">Criteria</th><th scope="col" class="text-end">Trades</th><th scope="col">Status</th></tr></thead>
            <tbody>
            @foreach (var setup in Model.Setups)
            {
                var selected = Model.SelectedSetup?.Setup.Id == setup.Id;
                <tr class="tf-setup-table-row @(selected ? "is-selected" : string.Empty)" data-setup-row>
                    <td><a class="tf-setup-table-link" href="@($"/journal/{Model.JournalId:D}/setups?setupId={setup.Id:D}")" data-setup-id="@setup.Id" aria-haspopup="dialog" aria-controls="setup-details">@setup.Name</a></td>
                    <td>@(string.IsNullOrWhiteSpace(setup.Category) ? "Uncategorized" : setup.Category)</td><td>v@(setup.CurrentVersion)</td><td class="text-end">@setup.CriteriaCount</td><td class="text-end">@setup.TradeCount</td>
                    <td><span class="tf-setup-list-status @(setup.Active ? "is-active" : "is-inactive")">@(setup.Active ? "Active" : "Inactive")</span></td>
                </tr>
            }
            </tbody>
        </table></div>
    }
</section>
@if (Model.SelectedSetup is not null)
{
        var setup = Model.SelectedSetup.Setup;
        var current = Model.CurrentVersion;
        <dialog id="setup-details" class="tf-setup-drawer tf-setup-details-drawer" aria-labelledby="setup-details-title" data-selected-setup="@setup.Id">
            <div class="tf-setup-drawer-shell">
                <header class="tf-setup-drawer-header"><h2 class="tf-card-title" id="setup-details-title">@setup.Name</h2><button class="btn btn-sm btn-ghost-secondary" type="button" data-setup-details-close aria-label="Close setup details">✕</button></header>
                <div class="tf-setup-drawer-body">
        <section class="card tf-card">
            <div class="card-header tf-card-header-split">
                <div><div class="tf-kicker">SETUP DEFINITION</div><h3 class="tf-card-title">@setup.Name</h3><span class="text-secondary">@(string.IsNullOrWhiteSpace(setup.Category) ? "Uncategorized" : setup.Category)</span></div>
                <div class="tf-setup-actions">
                    <button class="btn btn-sm btn-outline-primary" type="button" data-setup-open="metadata" aria-haspopup="dialog" aria-controls="setup-editor">Edit details</button>
                    <form method="post" asp-page-handler="SetActive" asp-route-journalId="@Model.JournalId" asp-route-setupId="@setup.Id">
                        @Html.AntiForgeryToken()<input type="hidden" name="setupId" value="@setup.Id" /><input type="hidden" name="active" value="@(setup.Active ? "false" : "true")" />
                        <button class="btn btn-sm @(setup.Active ? "btn-outline-danger" : "btn-outline-success")" type="submit">@(setup.Active ? "Deactivate" : "Reactivate")</button>
                    </form>
                </div>
            </div>
            <div class="card-body tf-setup-description">
                @if (!string.IsNullOrWhiteSpace(setup.ShortDescription)) { <p>@setup.ShortDescription</p> }
                @if (!string.IsNullOrWhiteSpace(setup.DetailedDescription)) { <p class="text-secondary tf-setup-notes">@setup.DetailedDescription</p> }
                @if (string.IsNullOrWhiteSpace(setup.ShortDescription) && string.IsNullOrWhiteSpace(setup.DetailedDescription)) { <p class="text-secondary">No description yet.</p> }
            </div>
        </section>
        @if (current is not null)
        {
            <section class="card tf-card">
                <div class="card-header tf-card-header-split">
                    <div><div class="tf-kicker">CURRENT DEFINITION</div><h3 class="tf-card-title">Version @current.Version</h3><span class="text-secondary">@TradeLabel(Model.SelectedSetupTradeCount) · @current.Criteria.Count(c => c.Active) active criteria</span></div>
                    <button class="btn btn-sm btn-outline-primary" type="button" data-setup-open="criteria" aria-haspopup="dialog" aria-controls="setup-editor">Edit criteria</button>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(current.Notes)) { <p class="text-secondary tf-setup-notes">@current.Notes</p> }
                    <div class="tf-setup-criteria-columns">
                    @foreach (var stage in Enum.GetValues<SetupCriterionStage>())
                    {
                        var stageCriteria = current.Criteria.Where(c => c.Stage == stage).ToList();
                        var activeCount = stageCriteria.Count(c => c.Active);
                        <section class="tf-setup-read-stage">
                            <h4 class="tf-setup-stage-heading"><span class="tf-setup-stage-symbol"><partial name="_SetupStageIcon" model="stage" /><span class="tf-setup-stage-count @(activeCount == 0 ? "is-empty" : "")" aria-label="@activeCount active criteria">@activeCount</span></span>@StageLabel(stage)</h4>
                            @if (stageCriteria.Count == 0)
                            {
                                <p class="text-secondary small mb-0">No criteria defined for this stage.</p>
                            }
                            else
                            {
<ul class="tf-setup-criteria-list" aria-label="@StageLabel(stage) criteria">
                                @foreach (var criterion in stageCriteria)
                                {
                                    <li class="tf-setup-criterion-card @(criterion.Active ? string.Empty : "is-inactive")"><strong>@criterion.Name</strong>@if (!criterion.Active) { <span class="tf-setup-criterion-tag">Inactive</span> }@if (!string.IsNullOrWhiteSpace(criterion.Description)) { <small>@criterion.Description</small> }<div class="tf-setup-criterion-meta"><span>@TypeLabel(criterion.CriterionType)</span><span>@criterion.EvaluationMode</span></div><form method="post" asp-page-handler="MoveCriterion" asp-route-journalId="@Model.JournalId" asp-route-setupId="@setup.Id" class="tf-criteria-order-form">@Html.AntiForgeryToken()<input type="hidden" name="setupId" value="@setup.Id" /><input type="hidden" name="criterionId" value="@criterion.Id" /><button class="btn btn-sm btn-ghost-secondary" type="submit" name="moveUp" value="true" aria-label="Move @criterion.Name up">↑</button><button class="btn btn-sm btn-ghost-secondary" type="submit" name="moveUp" value="false" aria-label="Move @criterion.Name down">↓</button></form></li>
                                }
                                </ul>
                            }
                        </section>
                    }
                    </div>
                </div>
            </section>
        }
        <details class="card tf-card tf-setup-disclosure">
            <summary class="card-header"><span class="tf-card-title">Historical versions</span><span class="text-secondary">@Model.SelectedSetup.Versions.Count versions</span></summary>
<div class="list-group list-group-flush">
                    @foreach (var version in Model.SelectedSetup.Versions)
                    {
                        <div class="list-group-item d-flex align-items-center justify-content-between gap-3"><span><strong>@setup.Name v@(version.Version)</strong><small class="d-block text-secondary">@version.Criteria.Count(c => c.Active) active criteria · @version.CreatedUtc.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</small></span><span class="badge bg-blue-lt">Historical definition</span></div>
                    }
                </div>

        </details>
                </div>
            </div>
        </dialog>
}
<details class="card tf-card tf-setup-disclosure" id="setup-performance">
    <summary class="card-header tf-card-header-split"><div><div class="tf-kicker">DESCRIPTIVE PERFORMANCE</div><h3 class="tf-card-title">Setup performance</h3><span class="text-secondary">Outcome metrics are shown separately from adherence; they do not redefine setup quality.</span></div><span class="text-secondary">@Model.Performance.Sum(item => item.Trades) associated trades</span></summary>
    <div class="card-body">
        @if (Model.Performance.Count == 0)
        {
            <p class="text-secondary mb-0">Attach a setup to a trade and evaluate it before performance rows appear.</p>
        }
        else
        {
            <div class="table-responsive"><table class="table table-vcenter tf-table tf-setup-performance-table"><caption class="visually-hidden">Descriptive performance by setup version.</caption><thead><tr><th>Setup</th><th>Trades</th><th>Win %</th><th>Avg P/L</th><th>Avg R</th><th>Avg MAE</th><th>Avg MFE</th><th>Required adherence</th></tr></thead><tbody>
            @foreach (var row in Model.Performance)
            {
                <tr><td><strong>@row.SetupName</strong><small>v@(row.Version)</small></td><td>@row.Trades</td><td>@Number(row.WinRatePercent, "0.0")%</td><td class="@(row.AveragePnl >= 0 ? "positive" : "negative")">@(row.AveragePnl?.ToString("C2", CultureInfo.CurrentCulture) ?? "—")</td><td>@Number(row.AverageR)</td><td>@Number(row.AverageMaePoints)</td><td>@Number(row.AverageMfePoints)</td><td>@(row.RequiredAdherencePercent.HasValue ? $"{row.RequiredAdherencePercent.Value:0.0}%" : "—")</td></tr>
            }
            </tbody></table></div>
            <p class="text-secondary small mb-0">MAE/MFE are absolute points using the existing trade evidence convention. Advanced criterion-by-outcome discovery is intentionally left to a later analytics phase.</p>
        }
    </div>
</details>


<dialog id="setup-editor" class="tf-setup-drawer" aria-labelledby="setup-editor-title" data-open-editor="@Model.OpenEditor">
    <div class="tf-setup-drawer-shell">
        <header class="tf-setup-drawer-header"><h2 class="tf-card-title" id="setup-editor-title">New setup</h2><button class="btn btn-sm btn-ghost-secondary" type="button" data-setup-close aria-label="Close setup editor">✕</button></header>
        <div class="tf-setup-drawer-body">
            @if (Model.OpenEditor is not null)
            {
                <div class="alert tf-alert error" role="alert" tabindex="-1" data-setup-error data-notification-exclude>@Model.FlashMessage</div>
            }
            <section data-setup-panel="create" hidden>
<form id="setup-form-create" method="post" asp-page-handler="CreateSetup" class="tf-setup-form" data-setup-drawer-criteria-editor data-criteria-prefix="NewCriteria" data-next-index="@Model.NewCriteria.Count">
                    @Html.AntiForgeryToken()
                    <label class="form-label">Name<input class="form-control" name="NewName" value="@Model.NewName" maxlength="120" required placeholder="e.g. Second Entry Long" /></label>
                    <label class="form-label">Category<input class="form-control" name="NewCategory" value="@Model.NewCategory" maxlength="100" placeholder="Pullback, reversal, breakout…" /></label>
                    <label class="form-label">Short description<input class="form-control" name="NewShortDescription" value="@Model.NewShortDescription" maxlength="500" placeholder="One-line explanation" /></label>
                    <label class="form-label">Detailed notes<textarea class="form-control" name="NewDetailedDescription" rows="3" maxlength="8000" placeholder="Definition notes and edge cases">@Model.NewDetailedDescription</textarea></label>
                    <div class="tf-criteria-editor" data-setup-criteria-list>
                        <div class="tf-criteria-editor-heading"><span>Initial criteria</span><button class="btn btn-sm btn-outline-secondary" type="button" data-criterion-add>Add criterion</button></div>
                        @for (var index = 0; index < Model.NewCriteria.Count; index++)
                        {
                            var criterion = Model.NewCriteria[index];
                            var prefix = $"NewCriteria[{index}]";
                            <div class="tf-criterion-editor-row" data-criterion-row>
                                <div class="tf-criterion-editor-main"><input class="form-control form-control-sm" name="@(prefix).Name" value="@criterion.Name" maxlength="240" placeholder="Criterion name" /><input class="form-control form-control-sm" name="@(prefix).Description" value="@criterion.Description" maxlength="1200" placeholder="What does this mean?" /></div>
                                <div class="tf-criterion-editor-options"><div class="tf-criterion-help-field"><select class="form-select form-select-sm" name="@(prefix).CriterionType" aria-label="Criterion type">@foreach (var type in Enum.GetValues<SetupCriterionType>()) { <option value="@type" selected="@(criterion.CriterionType == type ? "selected" : null)">@TypeLabel(type)</option> }</select><partial name="_SetupCriterionHelp" model='"type"' /></div><div class="tf-criterion-help-field"><select class="form-select form-select-sm" name="@(prefix).Stage" aria-label="Criterion stage">@foreach (var stage in Enum.GetValues<SetupCriterionStage>()) { <option value="@stage" selected="@(criterion.Stage == stage ? "selected" : null)">@StageLabel(stage)</option> }</select><partial name="_SetupCriterionHelp" model='"stage"' /></div><div class="tf-criterion-help-field"><select class="form-select form-select-sm" name="@(prefix).EvaluationMode" aria-label="Evaluation mode">@foreach (var mode in Enum.GetValues<SetupEvaluationMode>()) { <option value="@mode" selected="@(criterion.EvaluationMode == mode ? "selected" : null)">@mode</option> }</select><partial name="_SetupCriterionHelp" model='"mode"' /></div></div>
                                <div class="tf-criterion-editor-footer"><div class="tf-criterion-help-field"><label class="form-check form-check-inline mb-0"><input class="form-check-input" type="checkbox" name="@(prefix).Active" value="true" checked="@(criterion.Active ? "checked" : null)" /><span class="form-check-label">Active</span></label><partial name="_SetupCriterionHelp" model='"active"' /></div><input type="hidden" name="@(prefix).Active" value="false" /><div class="tf-criterion-help-field"><input class="form-control form-control-sm" name="@(prefix).RuleMetadataJson" value="@criterion.RuleMetadataJson" maxlength="4000" placeholder="Optional rule JSON" /><partial name="_SetupCriterionHelp" model='"rule"' /></div><button class="btn btn-sm btn-ghost-danger" type="button" data-criterion-remove>Remove</button></div>
                            </div>
                        }
                    </div>
                    <template data-setup-criterion-template><div class="tf-criterion-editor-row" data-criterion-row><div class="tf-criterion-editor-main"><input class="form-control form-control-sm" name="NewCriteria[__INDEX__].Name" maxlength="240" placeholder="Criterion name" /><input class="form-control form-control-sm" name="NewCriteria[__INDEX__].Description" maxlength="1200" placeholder="What does this mean?" /></div><div class="tf-criterion-editor-options"><div class="tf-criterion-help-field"><select class="form-select form-select-sm" name="NewCriteria[__INDEX__].CriterionType" aria-label="Criterion type"><option value="Required">Required</option><option value="Supporting">Supporting</option><option value="Disqualifier">Disqualifier</option><option value="Context">Context</option></select><partial name="_SetupCriterionHelp" model='"type"' /></div><div class="tf-criterion-help-field"><select class="form-select form-select-sm" name="NewCriteria[__INDEX__].Stage" aria-label="Criterion stage"><option value="Context">Context</option><option value="Setup" selected>Setup</option><option value="Trigger">Trigger</option><option value="Management">Management</option><option value="Exit">Exit</option></select><partial name="_SetupCriterionHelp" model='"stage"' /></div><div class="tf-criterion-help-field"><select class="form-select form-select-sm" name="NewCriteria[__INDEX__].EvaluationMode" aria-label="Evaluation mode"><option value="Manual" selected>Manual</option><option value="Automatic">Automatic</option><option value="Suggested">Suggested</option></select><partial name="_SetupCriterionHelp" model='"mode"' /></div></div><div class="tf-criterion-editor-footer"><div class="tf-criterion-help-field"><label class="form-check form-check-inline mb-0"><input class="form-check-input" type="checkbox" name="NewCriteria[__INDEX__].Active" value="true" checked /><span class="form-check-label">Active</span></label><partial name="_SetupCriterionHelp" model='"active"' /></div><input type="hidden" name="NewCriteria[__INDEX__].Active" value="false" /><div class="tf-criterion-help-field"><input class="form-control form-control-sm" name="NewCriteria[__INDEX__].RuleMetadataJson" maxlength="4000" placeholder="Optional rule JSON" /><partial name="_SetupCriterionHelp" model='"rule"' /></div><button class="btn btn-sm btn-ghost-danger" type="button" data-criterion-remove>Remove</button></div></div></template>

                </form>
            </section>
            @if (Model.SelectedSetup is not null)
            {
                var setup = Model.SelectedSetup.Setup;
                var current = Model.CurrentVersion;
                <section data-setup-panel="metadata" hidden>
<form id="setup-form-metadata" method="post" asp-page-handler="UpdateMetadata" asp-route-journalId="@Model.JournalId" asp-route-setupId="@setup.Id" class="tf-setup-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="setupId" value="@setup.Id" />
                        <div class="tf-setup-form-grid"><label class="form-label">Name<input class="form-control" name="EditName" value="@Model.EditName" maxlength="120" required /></label><label class="form-label">Category<input class="form-control" name="EditCategory" value="@Model.EditCategory" maxlength="100" /></label><label class="form-label tf-setup-form-wide">Short description<input class="form-control" name="EditShortDescription" value="@Model.EditShortDescription" maxlength="500" /></label><label class="form-label tf-setup-form-wide">Detailed notes<textarea class="form-control" name="EditDetailedDescription" rows="3" maxlength="8000">@Model.EditDetailedDescription</textarea></label></div>

                    </form>
                </section>
                @if (current is not null)
                {
                    <section data-setup-panel="criteria" hidden>
                        <p class="tf-setup-edit-state">@(Model.CanEditCurrentVersion ? $"This setup has not been used yet. Saving updates version {current.Version} directly." : $"Saving creates version {current.Version + 1}. Existing trade evaluations retain their original definitions.")</p>
<form id="setup-form-criteria" method="post" asp-page-handler="@(Model.CanEditCurrentVersion ? "UpdateCurrentVersion" : "CreateVersion")" asp-route-journalId="@Model.JournalId" asp-route-setupId="@setup.Id" class="tf-setup-form" data-setup-drawer-criteria-editor data-criteria-prefix="VersionCriteria" data-next-index="@Model.VersionCriteria.Count">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="setupId" value="@setup.Id" />
                                <label class="form-label">Version notes<input class="form-control" name="versionNotes" value="@Model.VersionNotes" maxlength="1000" placeholder="Notes about this definition" /></label>
                                <div class="tf-criteria-editor" data-setup-criteria-list>
                                    <div class="tf-criteria-editor-heading"><span>Criteria for version @current.Version</span><button class="btn btn-sm btn-outline-secondary" type="button" data-criterion-add>Add criterion</button></div>
                                    @for (var index = 0; index < Model.VersionCriteria.Count; index++)
                                    {
                                        var criterion = Model.VersionCriteria[index];
                                        var prefix = $"VersionCriteria[{index}]";
                                        <div class="tf-criterion-editor-row" data-criterion-row><div class="tf-criterion-editor-main"><input class="form-control form-control-sm" name="@(prefix).Name" value="@criterion.Name" maxlength="240" placeholder="Criterion name" /><input class="form-control form-control-sm" name="@(prefix).Description" value="@criterion.Description" maxlength="1200" placeholder="What does this mean?" /></div><div class="tf-criterion-editor-options"><div class="tf-criterion-help-field"><select class="form-select form-select-sm" name="@(prefix).CriterionType" aria-label="Criterion type">@foreach (var type in Enum.GetValues<SetupCriterionType>()) { <option value="@type" selected="@(criterion.CriterionType == type ? "selected" : null)">@TypeLabel(type)</option> }</select><partial name="_SetupCriterionHelp" model='"type"' /></div><div class="tf-criterion-help-field"><select class="form-select form-select-sm" name="@(prefix).Stage" aria-label="Criterion stage">@foreach (var stage in Enum.GetValues<SetupCriterionStage>()) { <option value="@stage" selected="@(criterion.Stage == stage ? "selected" : null)">@StageLabel(stage)</option> }</select><partial name="_SetupCriterionHelp" model='"stage"' /></div><div class="tf-criterion-help-field"><select class="form-select form-select-sm" name="@(prefix).EvaluationMode" aria-label="Evaluation mode">@foreach (var mode in Enum.GetValues<SetupEvaluationMode>()) { <option value="@mode" selected="@(criterion.EvaluationMode == mode ? "selected" : null)">@mode</option> }</select><partial name="_SetupCriterionHelp" model='"mode"' /></div></div><div class="tf-criterion-editor-footer"><div class="tf-criterion-help-field"><label class="form-check form-check-inline mb-0"><input class="form-check-input" type="checkbox" name="@(prefix).Active" value="true" checked="@(criterion.Active ? "checked" : null)" /><span class="form-check-label">Active</span></label><partial name="_SetupCriterionHelp" model='"active"' /></div><input type="hidden" name="@(prefix).Active" value="false" /><div class="tf-criterion-help-field"><input class="form-control form-control-sm" name="@(prefix).RuleMetadataJson" value="@criterion.RuleMetadataJson" maxlength="4000" placeholder="Optional rule JSON" /><partial name="_SetupCriterionHelp" model='"rule"' /></div><button class="btn btn-sm btn-ghost-danger" type="button" data-criterion-remove>Remove</button></div></div>
                                    }
                                </div>
                                <template data-setup-criterion-template><div class="tf-criterion-editor-row" data-criterion-row><div class="tf-criterion-editor-main"><input class="form-control form-control-sm" name="VersionCriteria[__INDEX__].Name" maxlength="240" placeholder="Criterion name" /><input class="form-control form-control-sm" name="VersionCriteria[__INDEX__].Description" maxlength="1200" placeholder="What does this mean?" /></div><div class="tf-criterion-editor-options"><div class="tf-criterion-help-field"><select class="form-select form-select-sm" name="VersionCriteria[__INDEX__].CriterionType" aria-label="Criterion type"><option value="Required">Required</option><option value="Supporting">Supporting</option><option value="Disqualifier">Disqualifier</option><option value="Context">Context</option></select><partial name="_SetupCriterionHelp" model='"type"' /></div><div class="tf-criterion-help-field"><select class="form-select form-select-sm" name="VersionCriteria[__INDEX__].Stage" aria-label="Criterion stage"><option value="Context">Context</option><option value="Setup" selected>Setup</option><option value="Trigger">Trigger</option><option value="Management">Management</option><option value="Exit">Exit</option></select><partial name="_SetupCriterionHelp" model='"stage"' /></div><div class="tf-criterion-help-field"><select class="form-select form-select-sm" name="VersionCriteria[__INDEX__].EvaluationMode" aria-label="Evaluation mode"><option value="Manual" selected>Manual</option><option value="Automatic">Automatic</option><option value="Suggested">Suggested</option></select><partial name="_SetupCriterionHelp" model='"mode"' /></div></div><div class="tf-criterion-editor-footer"><div class="tf-criterion-help-field"><label class="form-check form-check-inline mb-0"><input class="form-check-input" type="checkbox" name="VersionCriteria[__INDEX__].Active" value="true" checked /><span class="form-check-label">Active</span></label><partial name="_SetupCriterionHelp" model='"active"' /></div><input type="hidden" name="VersionCriteria[__INDEX__].Active" value="false" /><div class="tf-criterion-help-field"><input class="form-control form-control-sm" name="VersionCriteria[__INDEX__].RuleMetadataJson" maxlength="4000" placeholder="Optional rule JSON" /><partial name="_SetupCriterionHelp" model='"rule"' /></div><button class="btn btn-sm btn-ghost-danger" type="button" data-criterion-remove>Remove</button></div></div></template>

                            </form>
                    </section>
                }
            }
        </div>
        <footer class="tf-setup-drawer-footer"><button class="btn btn-outline-secondary" type="button" data-setup-close>Cancel</button><button class="btn btn-primary" type="submit" id="setup-editor-save">Create setup</button></footer>
    </div>
</dialog>
@section Scripts {
    <script src="~/js/setups.js" asp-append-version="true"></script>
}
